---
import { resolvePortraitSlug } from '../lib/portraits';
import { formatSigningDate } from '../lib/dates';
import { getYoungstownClassification } from '../lib/youngstown';

interface Props {
  order: {
    id: string;
    eo_number?: number | null;
    title: string;
    president_name: string;
    president_slug?: string;
    signing_date: string;
    word_count: number;
    reading_time_minutes: number;
    flesch_kincaid_grade: number;
    sentiment_compound: number;
    sentiment_valence: string;
    tone_tag?: string;
    snippet?: string;
  };
}

const { order } = Astro.props;
const portraitSlug = resolvePortraitSlug(order.president_slug);
const youngstown = getYoungstownClassification(order);

// Sentiment styling based on Early Statesman Constitutional Prism
let sentimentBadge = {
  label: "Constitutional Neutral",
  bg: "bg-slate-100 dark:bg-slate-800",
  text: "text-slate-700 dark:text-slate-300",
  border: "border-slate-200 dark:border-slate-700"
};

if (order.sentiment_valence === "Constitutional Fidelity" || order.sentiment_valence === "Positive") {
  sentimentBadge = {
    label: `Fidelity (${order.sentiment_compound >= 0 ? '+' : ''}${order.sentiment_compound.toFixed(2)})`,
    bg: "bg-emerald-50 dark:bg-emerald-950/40",
    text: "text-emerald-700 dark:text-emerald-300",
    border: "border-emerald-200 dark:border-emerald-800"
  };
} else if (order.sentiment_valence === "Constitutional Friction / Overreach" || order.sentiment_valence === "Urgent/Negative") {
  sentimentBadge = {
    label: `Friction (${order.sentiment_compound.toFixed(2)})`,
    bg: "bg-rose-50 dark:bg-rose-950/40",
    text: "text-rose-700 dark:text-rose-300",
    border: "border-rose-200 dark:border-rose-800"
  };
}

// Readability label
let gradeLabel = "Grade " + order.flesch_kincaid_grade;
if (order.flesch_kincaid_grade >= 16) gradeLabel = "Post-Graduate Legal";
else if (order.flesch_kincaid_grade >= 13) gradeLabel = "College Level";
else if (order.flesch_kincaid_grade >= 9) gradeLabel = "High School";

// Date formatting (timezone safe)
const formattedDate = formatSigningDate(order.signing_date);

const compactMeta = JSON.stringify({
  id: order.id,
  num: order.eo_number,
  title: order.title,
  pres: order.president_name,
  slug: order.president_slug,
  date: order.signing_date,
  words: order.word_count,
  time: order.reading_time_minutes,
  val: order.sentiment_valence,
  comp: order.sentiment_compound,
  tag: order.tone_tag,
  zone: youngstown.zone,
  snip: order.snippet
});
---

<article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200 flex flex-col justify-between">
  <div>
    <!-- Top Metadata Badges -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
      <div class="flex items-center gap-2">
        {order.eo_number ? (
          <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
            EO {order.eo_number}
          </span>
        ) : (
          <span class="font-mono text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            Order
          </span>
        )}
        <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
          {formattedDate}
        </span>
      </div>

      <div class="flex items-center gap-1.5">
        <!-- Youngstown Zone Pill -->
        <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${youngstown.badgeClass}`} title={youngstown.tagline}>
          {youngstown.icon} {youngstown.shortName}
        </span>
        <!-- Sentiment Pill -->
        <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full border ${sentimentBadge.bg} ${sentimentBadge.text} ${sentimentBadge.border}`}>
          {sentimentBadge.label}
        </span>
        <button
          type="button"
          data-bookmark-btn={order.id}
          data-order-meta={compactMeta}
          aria-label="Save this order"
          aria-pressed="false"
          class="p-1 rounded-md text-slate-400 hover:text-amber-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
        </button>
      </div>
    </div>

    <!-- Title -->
    <h3 class="font-serif font-bold text-slate-900 dark:text-white text-base sm:text-lg mb-2 line-clamp-2 hover:text-blue-600 dark:hover:text-blue-400">
      <a href={`/orders/${order.id}`}>
        {order.title}
      </a>
    </h3>

    <!-- Constitutional Tone Badge if available -->
    {order.tone_tag && (
      <div class="mb-3">
        <span class="inline-block text-[11px] font-sans font-medium px-2 py-0.5 rounded bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700/80">
          📜 {order.tone_tag}
        </span>
      </div>
    )}

    <!-- Plain text summary/snippet -->
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-3 mb-4 leading-relaxed font-sans">
      {order.snippet || "Historical Presidential decree and administrative action."}
    </p>
  </div>

  <!-- Bottom Metadata Row -->
  <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
    <!-- President Signature with portrait -->
    <div class="flex items-center gap-1.5 font-medium text-slate-700 dark:text-slate-300 truncate max-w-[55%]">
      <img
        src={`/portraits/${portraitSlug}.jpg`}
        alt=""
        class="w-4 h-4 rounded-full object-cover border border-slate-200 dark:border-slate-700 flex-shrink-0"
        onerror="this.style.display='none'"
      />
      <span class="truncate">{order.president_name}</span>
    </div>

    <!-- Metrics -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <span class="font-mono text-[11px]" title="Readability Grade Level">
        {gradeLabel}
      </span>
      <span>•</span>
      <span class="font-mono text-[11px]">
        {order.reading_time_minutes}m
      </span>
    </div>
  </div>
</article>
