---
interface Props {
  url: string;
  title: string;
  customShareText?: string;
  customTwitterText?: string;
  // Executive Order context
  eoNumber?: string | number | null;
  presidentName?: string;
  signingDate?: string;
  youngstownZone?: number;
  youngstownName?: string;
  youngstownTagline?: string;
  toneTag?: string;
  constitutionalValence?: string;
  sentimentCompound?: number;
  // President profile context
  presidentStats?: {
    totalOrders?: number;
    zone1Pct?: number;
    zone3Pct?: number;
    multiplier?: string;
  };
}

const {
  url,
  title,
  customShareText,
  customTwitterText,
  eoNumber,
  presidentName,
  signingDate,
  youngstownZone,
  youngstownName,
  youngstownTagline,
  toneTag,
  constitutionalValence,
  sentimentCompound,
  presidentStats
} = Astro.props;

// Ensure full URL for social link generation
const canonicalUrl = new URL(url, Astro.site || "https://executiveordersarchive.org").toString();

// Format display date
let formattedDate = '';
if (signingDate) {
  try {
    const [y, m, d] = signingDate.split('-');
    if (y && m && d) {
      formattedDate = new Date(parseInt(y), parseInt(m) - 1, parseInt(d)).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });
    }
  } catch (e) {
    formattedDate = signingDate;
  }
}

// Build standardized share text with maximal constitutional information
let computedShareText = customShareText || "";
let computedTwitterText = customTwitterText || "";

if (!computedShareText) {
  if (youngstownZone !== undefined || constitutionalValence) {
    // Executive Order specific text
    const eoLabel = eoNumber ? `U.S. Executive Order ${eoNumber}` : `U.S. Executive Order`;
    const scoreStr = sentimentCompound !== undefined ? ` (${sentimentCompound >= 0 ? '+' : ''}${sentimentCompound.toFixed(2)})` : '';
    
    let resolvedTagline = youngstownTagline;
    if (!resolvedTagline && youngstownZone) {
      if (youngstownZone === 1) resolvedTagline = "Express or Implied Congressional Authorization";
      else if (youngstownZone === 2) resolvedTagline = "Concurrent Authority / Congressional Silence";
      else if (youngstownZone === 3) resolvedTagline = "Incompatible with Expressed Will of Congress or High Friction";
    }

    const lines: string[] = [
      `${eoLabel}: "${title}"`
    ];
    if (presidentName) {
      lines.push(`Signed by ${presidentName}${formattedDate ? ` (${formattedDate})` : ''}`);
    }
    lines.push('');
    lines.push('⚖️ Constitutional Alignment:');
    if (youngstownName) {
      const tagSuffix = resolvedTagline ? ` (${resolvedTagline})` : '';
      lines.push(`• Separation of Powers: ${youngstownName}${tagSuffix}`);
    }
    if (toneTag) {
      lines.push(`• Constitutional Authority: ${toneTag}`);
    }
    if (constitutionalValence) {
      lines.push(`• Constitutional Valence: ${constitutionalValence}${scoreStr}`);
    }
    lines.push('');
    lines.push('Explore historical context & constitutional scoring:');
    computedShareText = lines.join('\n');

    // Concise tweet text (<240 chars to ensure room for t.co link)
    const shortTitle = title.length > 55 ? title.substring(0, 52).trim() + '...' : title;
    const zoneShort = youngstownZone ? `Zone ${youngstownZone}` : '';
    const valenceShort = constitutionalValence ? `${constitutionalValence}${scoreStr}` : '';
    const alignShort = [zoneShort, valenceShort].filter(Boolean).join(' • ');

    computedTwitterText = `${eoNumber ? `U.S. EO ${eoNumber}` : 'U.S. Order'}${presidentName ? ` (${presidentName})` : ''}: "${shortTitle}"\n⚖️ Alignment: ${alignShort}${toneTag ? `\n📜 Authority: ${toneTag}` : ''}`;
  } else if (presidentStats) {
    // President profile specific text
    const lines: string[] = [
      `${presidentName || title} — Executive Orders Constitutional Profile`
    ];
    if (presidentStats.totalOrders) {
      lines.push(`Tracked ${presidentStats.totalOrders} executive orders`);
    }
    lines.push('');
    lines.push('⚖️ Constitutional Analysis:');
    if (presidentStats.zone1Pct) {
      lines.push(`• Separation of Powers: ${presidentStats.zone1Pct}% Zone 1 (Statutory Authorization)`);
    }
    if (presidentStats.zone3Pct) {
      lines.push(`• Constitutional Friction: ${presidentStats.zone3Pct}% Zone 3 (Lowest Ebb)`);
    }
    if (presidentStats.multiplier) {
      lines.push(`• Power Inflation: ${presidentStats.multiplier}× Washington Baseline`);
    }
    lines.push('');
    lines.push('Explore the full presidential record on Executive Orders Archive:');
    computedShareText = lines.join('\n');

    computedTwitterText = `${presidentName || title} — Executive Orders Profile\n⚖️ Alignment: ${presidentStats.zone1Pct || '0'}% Zone 1 (Statutory)\n📈 Power Inflation: ${presidentStats.multiplier || '1'}× Washington Baseline`;
  } else {
    computedShareText = `${title}\n\nExplore full constitutional analysis on Executive Orders Archive:`;
    computedTwitterText = title;
  }
}

if (!computedTwitterText) {
  computedTwitterText = computedShareText.split('\n')[0] || title;
}

const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTwitterText = encodeURIComponent(computedTwitterText);
const encodedBlueskyText = encodeURIComponent(`${computedTwitterText}\n\n${canonicalUrl}`);
const shareHeadline = computedTwitterText.split('\n')[0] || title;
const encodedSubject = encodeURIComponent(shareHeadline);
const encodedFullBody = encodeURIComponent(`${computedShareText}\n\n${canonicalUrl}`);

const twitterHref = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTwitterText}`;
const redditHref = `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedSubject}`;
const threadsHref = `https://www.threads.net/intent/post?text=${encodedBlueskyText}`;
const blueskyHref = `https://bsky.app/intent/compose?text=${encodedBlueskyText}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const whatsappHref = `https://api.whatsapp.com/send?text=${encodedBlueskyText}`;
const mailtoHref = `mailto:?subject=${encodedSubject}&body=${encodedFullBody}`;
---

<div
  class="relative inline-flex items-center gap-1.5 sm:gap-2 flex-wrap"
  data-share-buttons
  data-share-url={canonicalUrl}
  data-share-title={title}
  data-share-text={computedShareText}
  data-twitter-text={computedTwitterText}
>
  <!-- Floating feedback toast -->
  <div
    data-share-toast
    class="hidden absolute -top-9 left-1/2 -translate-x-1/2 px-2.5 py-1 text-[11px] font-medium text-white bg-slate-900 dark:bg-slate-100 dark:text-slate-900 rounded-md shadow-lg pointer-events-none whitespace-nowrap z-50 transition-all duration-150"
  >
    <span data-share-toast-text>Link copied!</span>
    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900 dark:border-t-slate-100"></div>
  </div>

  <!-- Primary Universal Share Button (Web Share API on mobile / Rich clipboard on desktop) -->
  <button
    type="button"
    data-native-share
    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 transition-all duration-150 shadow-xs focus:outline-hidden focus:ring-2 focus:ring-amber-500/50"
    aria-label="Share this decree and constitutional alignment"
  >
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
    </svg>
    <span>Share</span>
  </button>

  <!-- Direct Platform Links -->
  <div class="flex items-center gap-0.5 sm:gap-1 flex-wrap">
    <!-- X / Twitter -->
    <a
      href={twitterHref}
      target="_blank"
      rel="noopener noreferrer"
      class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Share on X"
      title="Share on X"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 22.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>

    <!-- Reddit -->
    <a
      href={redditHref}
      target="_blank"
      rel="noopener noreferrer"
      class="p-1.5 rounded-lg text-slate-500 hover:text-[#FF4500] dark:text-slate-400 dark:hover:text-[#FF4500] hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Share on Reddit"
      title="Share on Reddit"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.703zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.197-2.512-.73a.326.326 0 0 0-.232-.095z"/>
      </svg>
    </a>

    <!-- Threads -->
    <a
      href={threadsHref}
      target="_blank"
      rel="noopener noreferrer"
      class="p-1.5 rounded-lg text-slate-500 hover:text-black dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Share on Threads"
      title="Share on Threads"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.265 18.306 1.5 15.466 1.5 11.992c0-3.597.893-6.524 2.656-8.701C6.012 1.002 8.736.002 12.012 0c3.551 0 6.377 1.087 8.398 3.232 1.956 2.076 2.898 5.006 2.8 8.71-.082 3.125-.972 5.626-2.646 7.433-1.637 1.767-3.864 2.693-6.621 2.753-2.12.046-3.92-.486-5.35-1.583-.342-.262-.647-.562-.916-.897l1.79-1.39c.65.782 1.638 1.488 3.12 1.455 3.513-.077 5.176-1.996 5.253-6.079h-3.649c-3.13 0-5.385-1.745-5.385-4.167 0-2.316 2.049-3.974 4.887-3.974 2.87 0 4.843 1.677 5.034 4.29h2.383c-.222-3.844-2.91-6.491-7.417-6.491-4.225 0-7.391 2.827-7.391 6.942 0 4.385 3.208 7.39 7.822 7.39 2.227 0 4.095-.694 5.553-2.063 1.344-1.262 2.128-3.084 2.27-5.267.114-4.256-2.074-8.89-7.234-8.89-4.88 0-7.904 3.498-7.904 9.176 0 5.419 2.918 8.913 7.643 8.944 2.247.015 4.148-.68 5.65-2.065l1.663 1.545C17.72 22.95 15.228 23.978 12.186 24zm-.174-10.742c1.378 0 2.502-.857 2.502-2.103 0-1.235-1.124-2.091-2.502-2.091-1.378 0-2.502.856-2.502 2.091 0 1.246 1.124 2.103 2.502 2.103z"/>
      </svg>
    </a>

    <!-- Bluesky -->
    <a
      href={blueskyHref}
      target="_blank"
      rel="noopener noreferrer"
      class="p-1.5 rounded-lg text-slate-500 hover:text-[#0285FF] dark:text-slate-400 dark:hover:text-[#0285FF] hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Share on Bluesky"
      title="Share on Bluesky"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 568 501">
        <path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.25 122.392-162.226-41.274-189.333-87.893-27.107 46.619-70.083 210.285-189.333 87.893C31.556 388.56 60.778 323.8 175.653 304.25c-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.66 0 75.293 0 57.947 0-28.906 76.135-1.612 123.121 33.664Z"/>
      </svg>
    </a>

    <!-- LinkedIn -->
    <a
      href={linkedinHref}
      target="_blank"
      rel="noopener noreferrer"
      class="p-1.5 rounded-lg text-slate-500 hover:text-[#0A66C2] dark:text-slate-400 dark:hover:text-[#0A66C2] hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Share on LinkedIn"
      title="Share on LinkedIn"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
      </svg>
    </a>

    <!-- Facebook -->
    <a
      href={facebookHref}
      target="_blank"
      rel="noopener noreferrer"
      class="p-1.5 rounded-lg text-slate-500 hover:text-[#1877F2] dark:text-slate-400 dark:hover:text-[#1877F2] hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Share on Facebook"
      title="Share on Facebook"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
    </a>

    <!-- WhatsApp -->
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="p-1.5 rounded-lg text-slate-500 hover:text-[#25D366] dark:text-slate-400 dark:hover:text-[#25D366] hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Share on WhatsApp"
      title="Share on WhatsApp"
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </a>

    <!-- Email -->
    <a
      href={mailtoHref}
      class="p-1.5 rounded-lg text-slate-500 hover:text-amber-600 dark:text-slate-400 dark:hover:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Email this decree"
      title="Email this decree"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
    </a>

    <!-- Copy Direct Link Button -->
    <button
      type="button"
      data-copy-link
      class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Copy direct link"
      title="Copy direct link"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
    </button>
  </div>
</div>

<script>
  // Dynamic handler for ShareButtons instances across orders and president pages
  document.querySelectorAll<HTMLElement>('[data-share-buttons]').forEach((container) => {
    const nativeBtn = container.querySelector<HTMLButtonElement>('[data-native-share]');
    const copyBtn = container.querySelector<HTMLButtonElement>('[data-copy-link]');
    const toast = container.querySelector<HTMLElement>('[data-share-toast]');
    const toastText = container.querySelector<HTMLElement>('[data-share-toast-text]');

    const url = container.dataset.shareUrl || window.location.href;
    const title = container.dataset.shareTitle || document.title;
    const shareText = container.dataset.shareText || '';

    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    function showToast(msg: string) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.classList.remove('hidden');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 2500);
    }

    // Native Web Share API
    nativeBtn?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title,
            text: shareText,
            url
          });
          return;
        } catch (err: any) {
          if (err.name === 'AbortError') return;
        }
      }

      // Desktop / fallback: Copy full constitutional summary + URL to clipboard
      try {
        const fullClip = shareText.includes(url) ? shareText : `${shareText}\n${url}`;
        await navigator.clipboard.writeText(fullClip);
        showToast('Constitutional summary & link copied!');
      } catch (e) {
        showToast('Failed to copy');
      }
    });

    // Copy clean direct link
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        showToast('Direct link copied!');
      } catch (e) {
        showToast('Failed to copy');
      }
    });
  });
</script>
