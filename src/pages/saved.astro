---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Saved Executive Orders"
  description="Your personal reading list of saved Executive Orders, stored locally in your browser."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200">Saved Orders</span>
    </nav>

    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <h1 class="font-serif font-extrabold text-3xl sm:text-4xl text-slate-900 dark:text-white">
          Saved Executive Orders
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-2xl">
          Your personal reading list. Saved orders are stored locally in your browser (via
          <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded font-mono">localStorage</code>) —
          nothing is sent to a server.
        </p>
      </div>

      <div class="flex items-center gap-2" id="export-controls">
        <button
          id="export-json-btn"
          type="button"
          aria-label="Export saved orders as JSON"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          <span>Export JSON</span>
        </button>
        <button
          id="export-csv-btn"
          type="button"
          aria-label="Export saved orders as CSV"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>Export CSV</span>
        </button>
      </div>
    </div>

    <div id="saved-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>

    <div id="saved-empty" class="hidden text-center py-20 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
      <p class="text-slate-600 dark:text-slate-400 text-base font-serif mb-1">You haven't saved any orders yet.</p>
      <p class="text-slate-400 text-xs mb-4">Click the bookmark icon on any order to add it to this list.</p>
      <a href="/orders" class="inline-block px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold">
        Browse All Orders
      </a>
    </div>

    <div id="saved-loading" class="text-center py-20 text-sm text-slate-400">
      Loading your saved orders&hellip;
    </div>

  </div>

  <script>
    const grid = document.getElementById('saved-grid');
    const empty = document.getElementById('saved-empty');
    const loading = document.getElementById('saved-loading');
    const exportJsonBtn = document.getElementById('export-json-btn');
    const exportCsvBtn = document.getElementById('export-csv-btn');
    const exportControls = document.getElementById('export-controls');

    let currentSavedOrders = [];

    // The page is always in exactly one view. setView() is the only place that
    // shows/hides the loading, empty, grid and export elements.
    //   loading -> list | empty | error
    //   list -> empty (last card unsaved); any -> render() again (changed in another tab)
    type View = 'loading' | 'empty' | 'list' | 'error';
    function setView(view: View, orders: any[] = []) {
      currentSavedOrders = view === 'list' ? orders : [];
      loading?.classList.toggle('hidden', view !== 'loading' && view !== 'error');
      if (loading) {
        loading.textContent = view === 'error' ? 'Failed to load saved orders.' : 'Loading your saved orders\u2026';
      }
      empty?.classList.toggle('hidden', view !== 'empty');
      exportControls?.classList.toggle('hidden', view !== 'list');
      if (grid) grid.innerHTML = view === 'list' ? orders.map(renderCard).join('') : '';
      if (view === 'list') window.EOBookmarks?.refreshAllButtons();
    }

    function renderCard(order) {
      return window.EOSearch.renderOrderCard(order, { savedView: true });
    }

    async function render() {
      const savedIds = window.EOBookmarks ? window.EOBookmarks.getAll() : [];
      if (savedIds.length === 0) return setView('empty');

      // Compact metadata cached in localStorage allows an instant render.
      const metaMap = window.EOBookmarks?.getMetadataMap ? window.EOBookmarks.getMetadataMap() : {};
      if (savedIds.every(id => metaMap[id])) {
        return setView('list', savedIds.map(id => metaMap[id]));
      }

      // Some metadata is missing: backfill from search_index.json.
      setView('loading');
      try {
        const allOrders = await window.EOSearch.loadIndex();
        const byId = new Map(allOrders.map(o => [o.id, o]));
        const orders = [];
        for (const id of savedIds) {
          let item = metaMap[id];
          if (!item && byId.has(id)) {
            item = window.EOSearch.bookmarkMeta(byId.get(id));
            window.EOBookmarks?.saveMetadata?.(id, item);
          }
          if (item) orders.push(item);
        }
        setView(orders.length ? 'list' : 'empty', orders);
      } catch (e) {
        console.error('Failed to load saved orders:', e);
        setView('error');
      }
    }

    // Export Handlers
    function downloadFile(content, fileName, mimeType) {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, 100);
    }

    // Sanitize CSV cells against spreadsheet formula injection (=, +, -, @, tab, CR)
    function csvCell(value) {
      if (value === null || value === undefined) return '';
      if (typeof value === 'number') return String(value);
      let s = String(value);
      if (/^[=+\-@\t\r]/.test(s)) {
        s = "'" + s;
      }
      if (/[",\r\n]/.test(s)) {
        return `"${s.replace(/"/g, '""')}"`;
      }
      return `"${s}"`;
    }

    exportJsonBtn?.addEventListener('click', () => {
      if (!currentSavedOrders.length) return;
      const dataStr = JSON.stringify(currentSavedOrders, null, 2);
      downloadFile(dataStr, 'saved-executive-orders.json', 'application/json');
    });

    exportCsvBtn?.addEventListener('click', () => {
      if (!currentSavedOrders.length) return;
      const headers = ['id', 'eo_number', 'title', 'president', 'signing_date', 'word_count', 'reading_time_minutes', 'constitutional_alignment', 'url'];
      const rows = currentSavedOrders.map(o => {
        const url = `${window.location.origin}/orders/${encodeURIComponent(o.id || '')}`;
        const fields = [
          csvCell(o.id || ''),
          csvCell(o.num || ''),
          csvCell(o.title || ''),
          csvCell(o.pres || ''),
          csvCell(o.date || ''),
          Number(o.words || 0),
          Number(o.time || 1),
          csvCell(o.val || ''),
          csvCell(url)
        ];
        return fields.join(',');
      });
      const csvContent = [headers.join(','), ...rows].join('\n');
      downloadFile(csvContent, 'saved-executive-orders.csv', 'text/csv');
    });

    // Unsaving a card on this page removes it in place; a change made in another
    // tab (detail.external) re-renders the whole list.
    document.addEventListener('eo-bookmarks-changed', (e) => {
      const detail = (e as CustomEvent).detail || {};
      if (detail.external) return void render();
      if (detail.saved) return;
      const safeSelectorId = typeof CSS !== 'undefined' && CSS.escape ? CSS.escape(String(detail.id)) : String(detail.id).replace(/"/g, '\\"');
      grid?.querySelector(`[data-saved-card="${safeSelectorId}"]`)?.remove();
      currentSavedOrders = currentSavedOrders.filter(o => o.id !== detail.id);
      if (currentSavedOrders.length === 0) setView('empty');
    });

    render();
  </script>
</Layout>
