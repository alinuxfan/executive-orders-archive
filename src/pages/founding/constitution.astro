---
import Layout from '../../layouts/Layout.astro';
import doc from '../../../data/founding/constitution.json';
---

<Layout 
  title="The United States Constitution (1787) | Full Unabridged Text & Article II"
  description="Read the complete, unabridged Constitution of the United States. Deep-dive into Article II: the Executive Power, Take Care Clause, and Commander-in-Chief powers."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/founding" class="hover:underline">Founding Documents</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200">The Constitution</span>
    </nav>

    <!-- Header Banner -->
    <header class="bg-blue-50/70 dark:bg-slate-900 border-2 border-blue-200 dark:border-blue-900/60 rounded-3xl p-6 sm:p-10 mb-8 shadow-sm text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-950 dark:bg-blue-950 dark:text-blue-300 text-xs font-semibold uppercase tracking-wider mb-3 font-sans border border-blue-200 dark:border-blue-800">
        <span>🏛️ The Supreme Law of the Land</span>
        <span>•</span>
        <span>{doc.location}</span>
      </div>
      <h1 class="font-serif font-extrabold text-3xl sm:text-4xl lg:text-5xl text-slate-900 dark:text-white leading-tight">
        {doc.title}
      </h1>
      <p class="font-serif italic text-base text-slate-600 dark:text-slate-300 mt-2 max-w-2xl mx-auto">
        Done in Convention by the Unanimous Consent of the States Present ({doc.formatted_date})
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 mt-6 pt-6 border-t border-blue-200/60 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 font-mono">
        <span>Word Count: <strong>{doc.word_count.toLocaleString()} words</strong></span>
        <span>•</span>
        <span>Articles: <strong>7 Articles</strong></span>
        <span>•</span>
        <span>Amendments: <a href="/founding/amendments" class="text-blue-600 dark:text-blue-400 underline font-bold">27 Ratified Amendments</a></span>
      </div>
    </header>

    <!-- Quick Article Jump Bar -->
    <div class="sticky top-20 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-3 shadow-md mb-10 overflow-x-auto">
      <div class="flex items-center gap-1.5 min-w-max text-xs font-medium font-sans">
        <span class="text-slate-400 font-mono uppercase tracking-wider px-2">Jump to:</span>
        <a href="#preamble" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300">Preamble</a>
        <a href="#article-1" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300">Art. I (Congress)</a>
        <a href="#article-2" class="px-3 py-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-bold shadow-sm">Art. II (President)</a>
        <a href="#article-3" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300">Art. III (Judiciary)</a>
        <a href="#article-4" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300">Art. IV (States)</a>
        <a href="#article-5" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300">Art. V (Amendments)</a>
        <a href="#article-6" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300">Art. VI (Supremacy)</a>
        <a href="#article-7" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300">Art. VII (Ratification)</a>
      </div>
    </div>

    <!-- Preamble Section -->
    <div id="preamble" class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-200 dark:border-slate-800 shadow-sm mb-12 scroll-mt-28">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 font-sans">Enacting Clause</span>
      <h2 class="font-serif font-bold text-2xl sm:text-3xl text-slate-900 dark:text-white mt-1 mb-4">
        The Preamble
      </h2>
      <p class="text-lg sm:text-xl text-slate-800 dark:text-slate-200 font-serif leading-relaxed italic border-l-4 border-blue-500 pl-4">
        "{doc.preamble}"
      </p>
    </div>

    <!-- Articles I through VII -->
    <div class="space-y-12">
      {doc.articles.map(art => {
        const isArticle2 = art.num === "II";
        const cardStyle = isArticle2 
          ? "border-2 border-amber-400 dark:border-amber-600/80 bg-gradient-to-b from-amber-50/30 to-white dark:from-slate-900 dark:to-slate-900 shadow-md ring-2 ring-amber-400/20"
          : "border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm";

        return (
          <section id={`article-${art.num.toLowerCase() === 'i' ? '1' : art.num.toLowerCase() === 'ii' ? '2' : art.num.toLowerCase() === 'iii' ? '3' : art.num.toLowerCase() === 'iv' ? '4' : art.num.toLowerCase() === 'v' ? '5' : art.num.toLowerCase() === 'vi' ? '6' : '7'}`} class={`rounded-3xl p-6 sm:p-10 ${cardStyle} scroll-mt-28`}>
            
            <!-- Article Header -->
            <div class="border-b border-slate-100 dark:border-slate-800 pb-6 mb-6">
              <div class="flex items-center gap-2 mb-2">
                <span class={`px-2.5 py-0.5 rounded font-mono font-bold text-xs uppercase tracking-wider ${isArticle2 ? 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300 border border-amber-300 dark:border-amber-700' : 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-300'}`}>
                  Article {art.num}
                </span>
                {isArticle2 && (
                  <span class="text-[11px] font-bold text-amber-700 dark:text-amber-400 font-sans uppercase tracking-wider flex items-center gap-1">
                    ★ Fountainhead of Executive Orders
                  </span>
                )}
              </div>

              <h2 class="font-serif font-bold text-2xl sm:text-3xl text-slate-900 dark:text-white">
                {art.title}
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-sans mt-2 leading-relaxed">
                {art.summary}
              </p>
            </div>

            <!-- Sections -->
            <div class="space-y-6">
              {art.sections.map(sec => (
                <div class={`p-5 rounded-2xl ${isArticle2 ? 'bg-amber-50/40 dark:bg-slate-850/60 border border-amber-200/60 dark:border-slate-800' : 'bg-slate-50/60 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800'}`}>
                  <div class="flex items-baseline gap-2 mb-2">
                    <span class="text-xs font-bold font-mono text-slate-500 uppercase">Section {sec.section}.</span>
                    <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 dark:text-white">
                      {sec.title}
                    </h3>
                  </div>
                  <div class="text-sm sm:text-base text-slate-800 dark:text-slate-200 font-serif leading-relaxed whitespace-pre-line">
                    {sec.text}
                  </div>
                </div>
              ))}
            </div>

          </section>
        );
      })}
    </div>

    <!-- Attestation and Link to Amendments -->
    <div class="mt-12 bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 text-center">
      <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2">
        Continue with the 27 Constitutional Amendments
      </h3>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto mb-6">
        Immediately following ratification in 1788, the first Congress drafted the Bill of Rights to establish concrete protections for individual liberties and reserved state powers.
      </p>
      <a 
        href="/founding/amendments"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm shadow-md transition-all font-sans"
      >
        <span>Explore All 27 Amendments</span>
        <span>&rarr;</span>
      </a>
    </div>

  </div>
</Layout>
