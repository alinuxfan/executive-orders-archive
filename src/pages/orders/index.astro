---
import Layout from '../../layouts/Layout.astro';
import orders from '../../../data/site_orders_summary.json';
import presidents from '../../../data/presidents.json';
import { formatPresidentNumbersHash } from '../../lib/presidentNumbers';

const totalOrders = orders.length;
const initialOrders = orders.slice(0, 48);

const signingYears = orders
  .map(o => o.signing_date ? new Date(o.signing_date).getFullYear() : null)
  .filter((y): y is number => y !== null && !Number.isNaN(y));
const minYear = Math.min(...signingYears);
const maxYear = Math.max(...signingYears);

// Keep in sync with TOPIC_PATTERNS / UNCATEGORIZED_TOPIC in scripts/topics.py
const TOPIC_OPTIONS = [
  "Agriculture",
  "Civil Rights & Liberties",
  "Criminal Justice & Law Enforcement",
  "Economy & Finance",
  "Education",
  "Energy & Environment",
  "Foreign Policy & Diplomacy",
  "Government Operations & Civil Service",
  "Healthcare & Public Health",
  "Housing",
  "Immigration & Border Security",
  "Infrastructure & Transportation",
  "Labor & Employment",
  "National Security & Defense",
  "Technology & Cybersecurity",
  "Trade & Tariffs",
  "Uncategorized",
];
---

<Layout 
  title="All Executive Orders | Presidential Archive"
  description="Browse and filter every United States Presidential Executive Order with constitutional sentiment ratings, reading time, and plain English summaries."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header -->
    <div class="mb-8">
      <div class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 font-sans mb-1">
        Presidential Decrees & Proclamations
      </div>
      <h1 class="font-serif font-extrabold text-3xl sm:text-4xl text-slate-900 dark:text-white">
        Executive Orders Archive ({totalOrders.toLocaleString()})
      </h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-2xl">
        Filter by constitutional alignment, era, or search by keywords. Every order includes quantitative reading times and Early Statesman distillations.
      </p>
    </div>

    <!-- Client-side Interactive Filter Bar -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-6 border border-slate-200 dark:border-slate-800 shadow-sm mb-8 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Keyword Search -->
        <div>
          <label for="order-search" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
            Search Titles & Topics
          </label>
          <input 
            type="text" 
            id="order-search"
            placeholder="Type keywords (e.g. defense, tariff)..."
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
          />
        </div>

        <!-- President Filter -->
        <div>
          <label for="president-select" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
            Filter by President
          </label>
          <select 
            id="president-select"
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
          >
            <option value="">All Presidents</option>
            {presidents.map(p => (
              <option value={p.name}>{p.name} ({formatPresidentNumbersHash(p.numbers)})</option>
            ))}
          </select>
        </div>

        <!-- Sentiment Valence Filter -->
        <div>
          <label for="sentiment-select" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
            Constitutional Alignment
          </label>
          <select 
            id="sentiment-select"
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
          >
            <option value="">All Constitutional Postures</option>
            <option value="Constitutional Fidelity">Constitutional Fidelity (Approved / Lawful)</option>
            <option value="Constitutional Neutral">Constitutional Neutral (Managerial Routine)</option>
            <option value="Constitutional Friction / Overreach">Constitutional Friction / Overreach</option>
          </select>
        </div>

        <!-- Topic Filter -->
        <div>
          <label for="topic-select" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
            Topic
          </label>
          <select
            id="topic-select"
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
          >
            <option value="">All Topics</option>
            {TOPIC_OPTIONS.map(topic => (
              <option value={topic}>{topic}</option>
            ))}
          </select>
        </div>

      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-100 dark:border-slate-800">

        <!-- From Year -->
        <div>
          <label for="year-from" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
            From Year
          </label>
          <input
            type="number"
            id="year-from"
            placeholder={String(minYear)}
            min={minYear}
            max={maxYear}
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
          />
        </div>

        <!-- To Year -->
        <div>
          <label for="year-to" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
            To Year
          </label>
          <input
            type="number"
            id="year-to"
            placeholder={String(maxYear)}
            min={minYear}
            max={maxYear}
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
          />
        </div>

        <!-- Sort -->
        <div class="col-span-2 sm:col-span-2">
          <label for="sort-select" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
            Sort By
          </label>
          <select
            id="sort-select"
            class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
          >
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
            <option value="longest">Longest (Word Count)</option>
            <option value="shortest">Shortest (Word Count)</option>
            <option value="friction">Most Constitutional Friction</option>
            <option value="fidelity">Most Constitutional Fidelity</option>
          </select>
        </div>

      </div>

      <!-- Quick Active Filter Tags & Count -->
      <div class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-100 dark:border-slate-800">
        <span id="match-counter">Showing recent orders</span>
        <button id="reset-filters" class="text-blue-600 dark:text-blue-400 hover:underline">Reset Filters</button>
      </div>
    </div>

    <!-- Orders Grid -->
    <div id="orders-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Dynamically filled with cards -->
    </div>

    <!-- Load More Button -->
    <div id="load-more-container" class="text-center mt-10 mb-8">
      <button 
        id="load-more-orders"
        class="px-6 py-2.5 bg-slate-800 hover:bg-slate-700 text-white dark:bg-slate-700 dark:hover:bg-slate-600 rounded-xl text-sm font-semibold shadow transition-colors"
      >
        Load More Orders
      </button>
    </div>

    <div id="no-results" class="hidden text-center py-16 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
      <p class="text-slate-500 dark:text-slate-400 text-sm">No executive orders match your filter criteria.</p>
    </div>

  </div>

  <script is:inline define:vars={{ initialOrders, totalOrders }}>
    const searchInput = document.getElementById('order-search');
    const presSelect = document.getElementById('president-select');
    const sentSelect = document.getElementById('sentiment-select');
    const yearFromInput = document.getElementById('year-from');
    const yearToInput = document.getElementById('year-to');
    const sortSelect = document.getElementById('sort-select');
    const topicSelect = document.getElementById('topic-select');
    const resetBtn = document.getElementById('reset-filters');
    const counter = document.getElementById('match-counter');
    const noResults = document.getElementById('no-results');
    const ordersContainer = document.getElementById('orders-container');
    const loadMoreBtn = document.getElementById('load-more-orders');
    const loadMoreContainer = document.getElementById('load-more-container');

    function sortItems(list, sortMode) {
      const sorted = [...list];
      const getComp = o => (o.comp !== undefined ? o.comp : (o.sentiment_compound || 0));
      const getWords = o => (o.words !== undefined ? o.words : (o.word_count || 0));
      const getDate = o => new Date(o.date || o.signing_date || 0).getTime();
      switch (sortMode) {
        case 'oldest':
          sorted.sort((a, b) => getDate(a) - getDate(b));
          break;
        case 'longest':
          sorted.sort((a, b) => getWords(b) - getWords(a));
          break;
        case 'shortest':
          sorted.sort((a, b) => getWords(a) - getWords(b));
          break;
        case 'friction':
          sorted.sort((a, b) => getComp(a) - getComp(b));
          break;
        case 'fidelity':
          sorted.sort((a, b) => getComp(b) - getComp(a));
          break;
        case 'newest':
        default:
          sorted.sort((a, b) => getDate(b) - getDate(a));
      }
      return sorted;
    }

    function syncUrl() {
      const params = new URLSearchParams();
      if (searchInput?.value) params.set('q', searchInput.value);
      if (presSelect?.value) params.set('president', presSelect.value);
      if (sentSelect?.value) params.set('sentiment', sentSelect.value);
      if (topicSelect?.value) params.set('topic', topicSelect.value);
      if (yearFromInput?.value) params.set('from', yearFromInput.value);
      if (yearToInput?.value) params.set('to', yearToInput.value);
      if (sortSelect?.value && sortSelect.value !== 'newest') params.set('sort', sortSelect.value);
      const qs = params.toString();
      const newUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.replaceState(null, '', newUrl);
    }

    let allOrders = null;
    let filteredOrders = [];
    let displayedCount = 0;
    let yearDebounceTimer;
    const BATCH_SIZE = 48;

    function renderOrderCard(order) {
      let sentimentBadge = {
        label: "Constitutional Neutral",
        bg: "bg-slate-100 dark:bg-slate-800",
        text: "text-slate-700 dark:text-slate-300",
        border: "border-slate-200 dark:border-slate-700"
      };

      const val = order.val || order.sentiment_valence;
      const comp = order.comp !== undefined ? order.comp : (order.sentiment_compound || 0);

      if (val === "Constitutional Fidelity" || val === "Positive") {
        sentimentBadge = {
          label: `Fidelity (${comp >= 0 ? '+' : ''}${comp.toFixed(2)})`,
          bg: "bg-emerald-50 dark:bg-emerald-950/40",
          text: "text-emerald-700 dark:text-emerald-300",
          border: "border-emerald-200 dark:border-emerald-800"
        };
      } else if (val === "Constitutional Friction / Overreach" || val === "Urgent/Negative") {
        sentimentBadge = {
          label: `Friction (${comp.toFixed(2)})`,
          bg: "bg-rose-50 dark:bg-rose-950/40",
          text: "text-rose-700 dark:text-rose-300",
          border: "border-rose-200 dark:border-rose-800"
        };
      }

      const rawDate = order.date || order.signing_date;
      const formattedDate = rawDate ? new Date(rawDate).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric"
      }) : "Undated";

      const num = order.num !== undefined ? order.num : order.eo_number;
      const eoBadge = num ? 
        `<span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900">EO ${num}</span>` :
        `<span class="font-mono text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">Order</span>`;

      const presName = order.pres || order.president_name;
      const slug = window.resolvePortraitSlug(order.slug || order.president_slug);
      const readTime = order.time || order.reading_time_minutes || 1;
      const wordCount = (order.words || order.word_count || 0).toLocaleString();
      const toneTag = order.tag || order.tone_tag;
      const snippet = order.snip || order.snippet;

      return `
        <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
              <div class="flex items-center gap-2">
                ${eoBadge}
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">${formattedDate}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full border ${sentimentBadge.bg} ${sentimentBadge.text} ${sentimentBadge.border}">
                  ${sentimentBadge.label}
                </span>
                <button type="button" data-bookmark-btn="${order.id}" aria-label="Save this order" aria-pressed="false" class="p-1 rounded-md text-slate-400 hover:text-amber-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                </button>
              </div>
            </div>
            <h3 class="font-serif font-bold text-slate-900 dark:text-white text-base sm:text-lg mb-2 line-clamp-2 hover:text-blue-600 dark:hover:text-blue-400">
              <a href="/orders/${order.id}">${order.title}</a>
            </h3>
            ${toneTag ? `
              <div class="mb-3">
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-200 border border-amber-200 dark:border-amber-900/60 font-medium">
                  🏛️ ${toneTag}
                </span>
              </div>
            ` : ''}
            ${snippet ? `<p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">${snippet}</p>` : ''}
          </div>
          <div class="pt-3 mt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
            <div class="flex items-center gap-1.5 font-medium">
              <img src="/portraits/${slug}.jpg" alt="" class="w-5 h-5 rounded-full object-cover border border-slate-300 dark:border-slate-600" onerror="this.style.display='none'" />
              <span class="text-slate-700 dark:text-slate-300 truncate max-w-[140px] sm:max-w-none">${presName}</span>
            </div>
            <div class="flex items-center gap-2 font-mono text-[11px]">
              <span title="Estimated Reading Time">⏱ ${readTime}m</span>
              <span class="opacity-40">•</span>
              <span title="Word Count">${wordCount} words</span>
            </div>
          </div>
        </article>
      `;
    }

    function appendBatch(reset = false) {
      if (reset) {
        ordersContainer.innerHTML = '';
        displayedCount = 0;
      }
      const slice = filteredOrders.slice(displayedCount, displayedCount + BATCH_SIZE);
      if (slice.length > 0) {
        ordersContainer.innerHTML += slice.map(renderOrderCard).join('');
        displayedCount += slice.length;
        window.EOBookmarks?.refreshAllButtons();
      }

      if (displayedCount < filteredOrders.length) {
        loadMoreContainer.classList.remove('hidden');
      } else {
        loadMoreContainer.classList.add('hidden');
      }

      if (filteredOrders.length === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    async function loadIndex() {
      if (allOrders) return allOrders;
      try {
        const res = await fetch('/search_index.json');
        allOrders = await res.json();
      } catch (e) {
        console.error('Failed to load dataset:', e);
        allOrders = initialOrders;
      }
      return allOrders;
    }

    function getTopics(item) {
      if (Array.isArray(item.topics)) return item.topics;
      if (item.topic_tags_json) {
        try { return JSON.parse(item.topic_tags_json); } catch (e) { return []; }
      }
      return [];
    }

    async function applyFilters() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const pres = (presSelect?.value || '').toLowerCase();
      const sent = sentSelect?.value || '';
      const topic = topicSelect?.value || '';
      const yearFrom = yearFromInput?.value ? parseInt(yearFromInput.value, 10) : null;
      const yearTo = yearToInput?.value ? parseInt(yearToInput.value, 10) : null;
      const sortMode = sortSelect?.value || 'newest';
      const terms = q.split(/\s+/).filter(Boolean);

      const dataset = await loadIndex();

      filteredOrders = dataset.filter(item => {
        const itemPres = (item.pres || item.president_name || '').toLowerCase();
        const itemVal = item.val || item.sentiment_valence || '';
        const itemNum = item.num !== undefined ? String(item.num) : String(item.eo_number || '');
        const itemYear = (item.date || item.signing_date) ? new Date(item.date || item.signing_date).getFullYear() : null;
        const hay = `${item.title} ${itemNum} ${item.snip || item.snippet || ''} ${item.tag || item.tone_tag || ''} ${item.kw || ''}`.toLowerCase();

        const matchQ = terms.length === 0 || terms.every(term => hay.includes(term));
        const matchPres = !pres || itemPres.includes(pres);
        const matchSent = !sent || itemVal === sent;
        const matchTopic = !topic || getTopics(item).includes(topic);
        const matchYearFrom = yearFrom === null || (itemYear !== null && itemYear >= yearFrom);
        const matchYearTo = yearTo === null || (itemYear !== null && itemYear <= yearTo);

        return matchQ && matchPres && matchSent && matchTopic && matchYearFrom && matchYearTo;
      });

      filteredOrders = sortItems(filteredOrders, sortMode);

      if (counter) counter.textContent = `Showing ${filteredOrders.length.toLocaleString()} matching orders`;
      appendBatch(true);
      syncUrl();
    }

    // Hydrate from URL params (shareable/bookmarkable filtered views)
    const urlParams = new URLSearchParams(window.location.search);
    const initialQ = urlParams.get('q');
    const initialPres = urlParams.get('president');
    const initialSent = urlParams.get('sentiment');
    const initialTopic = urlParams.get('topic');
    const initialFrom = urlParams.get('from');
    const initialTo = urlParams.get('to');
    const initialSort = urlParams.get('sort');
    let hasUrlFilters = false;

    if (initialQ && searchInput) { searchInput.value = initialQ; hasUrlFilters = true; }
    if (initialPres && presSelect) { presSelect.value = initialPres; hasUrlFilters = true; }
    if (initialSent && sentSelect) { sentSelect.value = initialSent; hasUrlFilters = true; }
    if (initialTopic && topicSelect) { topicSelect.value = initialTopic; hasUrlFilters = true; }
    if (initialFrom && yearFromInput) { yearFromInput.value = initialFrom; hasUrlFilters = true; }
    if (initialTo && yearToInput) { yearToInput.value = initialTo; hasUrlFilters = true; }
    if (initialSort && sortSelect) { sortSelect.value = initialSort; hasUrlFilters = true; }

    // Initial hydration
    if (hasUrlFilters) {
      applyFilters();
    } else {
      filteredOrders = initialOrders;
      appendBatch(true);
    }
    setTimeout(loadIndex, 500);

    searchInput?.addEventListener('input', () => {
      applyFilters();
    });
    presSelect?.addEventListener('change', applyFilters);
    sentSelect?.addEventListener('change', applyFilters);
    topicSelect?.addEventListener('change', applyFilters);
    yearFromInput?.addEventListener('input', () => {
      clearTimeout(yearDebounceTimer);
      yearDebounceTimer = setTimeout(applyFilters, 300);
    });
    yearToInput?.addEventListener('input', () => {
      clearTimeout(yearDebounceTimer);
      yearDebounceTimer = setTimeout(applyFilters, 300);
    });
    sortSelect?.addEventListener('change', applyFilters);

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (presSelect) presSelect.value = '';
      if (sentSelect) sentSelect.value = '';
      if (topicSelect) topicSelect.value = '';
      if (yearFromInput) yearFromInput.value = '';
      if (yearToInput) yearToInput.value = '';
      if (sortSelect) sortSelect.value = 'newest';
      if (counter) counter.textContent = `Showing recent orders`;
      filteredOrders = initialOrders;
      appendBatch(true);
      window.history.replaceState(null, '', window.location.pathname);
    });

    loadMoreBtn?.addEventListener('click', async () => {
      if (filteredOrders === initialOrders) {
        const dataset = await loadIndex();
        filteredOrders = sortItems(dataset, sortSelect?.value || 'newest');
      }
      appendBatch(false);
    });
  </script>
</Layout>
