---
import Layout from '../../layouts/Layout.astro';
import CitationBox from '../../components/CitationBox.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import OrderCard from '../../components/OrderCard.astro';
import { generateOrderSummary } from '../../lib/summary';
import { getRelatedOrders, getReferencedByLater } from '../../lib/relatedOrders';
import { resolvePortraitSlug } from '../../lib/portraits';
import { formatSigningDate } from '../../lib/dates';
import rawOrders from '../../../data/site_orders.json';

export async function getStaticPaths() {
  return rawOrders.map(order => ({
    params: { id: order.id },
    props: { order }
  }));
}

const { order } = Astro.props;

// Plain English summary and directives fallback
const fallbackSummary = generateOrderSummary({
  title: order.title,
  president_name: order.president_name,
  signing_date: order.signing_date,
  full_text: order.full_text || "",
  sentiment_valence: order.sentiment_valence,
  word_count: order.word_count
});

// Use database-backed constitutional evaluations when available
let directives = fallbackSummary.keyDirectives;
if (order.key_directives_json) {
  try {
    const parsed = JSON.parse(order.key_directives_json);
    if (Array.isArray(parsed) && parsed.length > 0) {
      directives = parsed;
    }
  } catch (e) {}
}

let affectedEntities = fallbackSummary.whoItAffects;
if (order.who_it_affects_json) {
  try {
    const parsed = JSON.parse(order.who_it_affects_json);
    if (Array.isArray(parsed) && parsed.length > 0) {
      affectedEntities = parsed;
    }
  } catch (e) {}
}

let topicTags: string[] = [];
if (Array.isArray(order.topic_tags)) {
  topicTags = order.topic_tags;
} else if (order.topic_tags_json) {
  try {
    const parsed = JSON.parse(order.topic_tags_json);
    if (Array.isArray(parsed)) topicTags = parsed;
  } catch (e) {}
}

const rawSummaryText = order.summary_plain_english || fallbackSummary.plainEnglish;
const summaryParagraphs = rawSummaryText.split("\n\n").filter(p => p.trim().length > 0);

// Format date
const formattedDate = order.signing_date ? formatSigningDate(order.signing_date, {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric"
}) : "Date not specified";

// Sentiment badge
let sentimentColor = {
  bg: "bg-slate-100 dark:bg-slate-800",
  text: "text-slate-700 dark:text-slate-300",
  border: "border-slate-300 dark:border-slate-700"
};

if (order.sentiment_valence === "Constitutional Fidelity" || order.sentiment_valence === "Positive") {
  sentimentColor = {
    bg: "bg-emerald-50 dark:bg-emerald-950/40",
    text: "text-emerald-700 dark:text-emerald-300",
    border: "border-emerald-300 dark:border-emerald-800"
  };
} else if (order.sentiment_valence === "Constitutional Friction / Overreach" || order.sentiment_valence === "Urgent/Negative") {
  sentimentColor = {
    bg: "bg-rose-50 dark:bg-rose-950/40",
    text: "text-rose-700 dark:text-rose-300",
    border: "border-rose-300 dark:border-rose-800"
  };
}

const orderCanonicalUrl = new URL(`/orders/${order.id}`, Astro.site).toString();
const portraitSlug = resolvePortraitSlug(order.president_slug);

const compactMeta = JSON.stringify({
  id: order.id,
  num: order.eo_number,
  title: order.title,
  pres: order.president_name,
  slug: order.president_slug,
  date: order.signing_date,
  words: order.word_count,
  time: order.reading_time_minutes,
  val: order.sentiment_valence,
  comp: order.sentiment_compound,
  tag: order.tone_tag,
  snip: summaryParagraphs[0] || ''
});

const legislationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Legislation",
  "name": order.title,
  "legislationIdentifier": order.eo_number ? `EO ${order.eo_number}` : order.id,
  "legislationType": order.eo_number ? "Executive Order" : "Presidential Order",
  "legislationDate": order.signing_date || undefined,
  "datePublished": order.signing_date || undefined,
  "legislationJurisdiction": "United States",
  "author": {
    "@type": "Person",
    "name": order.president_name
  },
  "description": summaryParagraphs[0] || order.title,
  "url": orderCanonicalUrl,
  "inLanguage": "en-US"
};

// Related Orders: cross-referenced EO numbers mentioned in the text, plus same-president orders
// signed closest in time, as a fallback / supplement.
const { related: relatedOrders, referencedCount } = getRelatedOrders(order);
const referencedByLater = getReferencedByLater(order);

function relationBadgeClasses(relation: string): string {
  if (relation === 'Revokes' || relation === 'Rescinds' || relation === 'Supersedes') {
    return 'bg-rose-600 text-white border-rose-700';
  }
  if (relation === 'Amends') {
    return 'bg-amber-500 text-white border-amber-600';
  }
  return 'bg-slate-600 text-white border-slate-700';
}

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Orders", "item": new URL("/orders", Astro.site).toString() },
    { "@type": "ListItem", "position": 3, "name": order.title, "item": orderCanonicalUrl }
  ]
};
---

<Layout
  title={order.title}
  description={summaryParagraphs[0] || order.title}
  image={order.president_slug ? `/portraits/${portraitSlug}.jpg` : '/og-default.png'}
  type="article"
  structuredData={[legislationJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Breadcrumb -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 print:hidden">
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-mono">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/orders" class="hover:underline">Orders</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 truncate max-w-xs">{order.id}</span>
      </nav>
      <div class="flex items-center gap-3">
        <button
          type="button"
          onclick="window.print()"
          aria-label="Print or save this order as a PDF"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-semibold transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a1 1 0 001-1v-5H8v5a1 1 0 001 1zm8-12V5a1 1 0 00-1-1H8a1 1 0 00-1 1v4h10z\"></path></svg>
          <span>Print / PDF</span>
        </button>
        <button
          type="button"
          data-bookmark-btn={order.id}
          data-order-meta={compactMeta}
          aria-label="Save this order"
          aria-pressed="false"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-semibold transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
          <span data-bookmark-label>Save</span>
        </button>
        <ShareButtons url={`/orders/${order.id}`} title={order.title} />
      </div>
    </div>

    <!-- Document Header -->
    <header class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 mb-8 shadow-sm">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        {order.eo_number ? (
          <span class="font-mono text-sm font-bold px-2.5 py-1 rounded bg-blue-100 text-blue-900 dark:bg-blue-950 dark:text-blue-200 border border-blue-200 dark:border-blue-900">
            Executive Order {order.eo_number}
          </span>
        ) : (
          <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            Presidential Order
          </span>
        )}
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${sentimentColor.bg} ${sentimentColor.text} ${sentimentColor.border}`}>
          {order.sentiment_valence} ({order.sentiment_compound >= 0 ? '+' : ''}{order.sentiment_compound.toFixed(2)})
        </span>
      </div>

      <h1 class="font-serif font-extrabold text-2xl sm:text-3xl lg:text-4xl text-slate-900 dark:text-white leading-tight mb-4">
        {order.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-500 dark:text-slate-400 pt-4 border-t border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-2 font-medium text-slate-800 dark:text-slate-200">
          <img
            src={`/portraits/${portraitSlug}.jpg`}
            alt={order.president_name}
            class="w-6 h-6 rounded-full object-cover border border-slate-300 dark:border-slate-600"
            onerror="this.style.display='none'"
          />
          {portraitSlug !== 'default' ? (
            <a href={`/presidents/${portraitSlug}`} class="hover:underline">
              {order.president_name}
            </a>
          ) : (
            <span>{order.president_name}</span>
          )}
        </div>
        <span>•</span>
        <div class="font-mono">{formattedDate}</div>
        <span>•</span>
        <div>{order.reading_time_minutes} min read ({order.word_count.toLocaleString()} words)</div>
      </div>
    </header>

    <!-- Plain-English Translation & Constitutional Analysis Callout -->
    <section class="bg-amber-50/50 dark:bg-amber-950/20 border-2 border-amber-200/80 dark:border-amber-900/40 rounded-2xl p-6 sm:p-8 mb-8 shadow-sm">
      <div class="flex items-center gap-3 mb-4">
        <div class="p-2 rounded-xl bg-amber-100 dark:bg-amber-900/50 text-amber-900 dark:text-amber-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
          <h2 class="font-serif font-bold text-lg text-slate-900 dark:text-white">
            Plain-English Translation & Framers' Constitutional Analysis
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Early Statesman synthesis distilling legal jargon into practical meaning, statutory anchors, and structural constitutional impacts.
          </p>
        </div>
      </div>

      <div class="space-y-4 mb-6">
        {summaryParagraphs.map(p => {
          const isCallout = p.startsWith("CONSTITUTIONAL") || p.startsWith("EXECUTIVE POWERS") || p.startsWith("STATUTORY");
          return isCallout ? (
            <div class="p-4 rounded-xl bg-amber-100/60 dark:bg-amber-900/30 border border-amber-300/50 dark:border-amber-800/50 text-xs font-mono text-amber-950 dark:text-amber-200 leading-relaxed">
              {p}
            </div>
          ) : (
            <p class="text-slate-800 dark:text-slate-200 text-base leading-relaxed font-normal">
              {p}
            </p>
          );
        })}
      </div>

      <!-- Key Directives -->
      <div class="space-y-3 mb-6">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Key Directives & Operative Actions
        </h3>
        <div class="grid grid-cols-1 gap-2.5">
          {directives.map((d, idx) => {
            const anchorId = `directive-${idx + 1}`;
            return (
              <div id={anchorId} class="scroll-mt-24 group relative p-3.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 text-sm text-slate-700 dark:text-slate-300 flex items-start gap-3 target:ring-2 target:ring-amber-400">
                <span class="text-amber-500 font-bold mt-0.5">▪</span>
                <span class="flex-1">{d.description}</span>
                <button
                  type="button"
                  data-copy-anchor={anchorId}
                  aria-label="Copy link to this directive"
                  title="Copy link to this directive"
                  class="flex-shrink-0 opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity text-slate-400 hover:text-amber-500"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5"></path></svg>
                </button>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Who It Affects -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
          Constitutional & Societal Entities Impacted
        </h3>
        <div class="flex flex-wrap gap-2">
          {affectedEntities.map(entity => (
            <span class="px-3 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-200 shadow-2xs">
              🏛️ {entity}
            </span>
          ))}
        </div>
      </div>

      <!-- Policy Areas & Topics -->
      {topicTags.length > 0 && (
        <div class="mt-4 pt-4 border-t border-amber-200/60 dark:border-amber-900/40">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
            Policy Areas & Topics
          </h3>
          <div class="flex flex-wrap gap-2">
            {topicTags.map(topic => (
              <a
                href={`/orders?topic=${encodeURIComponent(topic)}`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-amber-100/70 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-200 transition-colors shadow-2xs"
              >
                <span>🏷️</span>
                <span>{topic}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- Quantitative Metrics Panel -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      
      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1">Total Words</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.word_count.toLocaleString()}
        </div>
        <div class="text-[10px] text-slate-500 mt-1">{order.char_count.toLocaleString()} characters</div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1">Estimated Read Time</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.reading_time_minutes} <span class="text-xs font-sans font-normal">min</span>
        </div>
        <div class="text-[10px] text-slate-500 mt-1">@ 200 words / min</div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1">Flesch-Kincaid</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.flesch_kincaid_grade}
        </div>
        <div class="text-[10px] text-slate-500 mt-1">Post-Grad reading level</div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1">Constitutional Polarity</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.sentiment_compound >= 0 ? '+' : ''}{order.sentiment_compound.toFixed(2)}
        </div>
        <div class="text-[10px] text-slate-500 mt-1">Framers' Alignment index</div>
      </div>

    </section>

    <!-- Scholarly & Legal Citation Panel -->
    <CitationBox order={order} />

    <!-- Full Official Document Text -->
    <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-10 shadow-sm">
      <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="font-serif font-bold text-xl text-slate-900 dark:text-white">
            Official Document Text
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Source: {order.source === 'federal_register' ? 'Federal Register (Official Presidential Document)' : 'The American Presidency Project (UCSB Archive)'}
          </p>
        </div>

        <div class="flex items-center gap-2">
          {order.source_url ? (
            <a
              href={order.source_url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors"
            >
              Original Source &rarr;
            </a>
          ) : null}
        </div>
      </div>

      <!-- Accessibility Toolbar: text size + read-aloud, for the Post-Graduate-level
           legal text this page itself flags via the Flesch-Kincaid metric above -->
      <div class="print:hidden flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800/80">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mr-1">Text Size</span>
          <button
            type="button"
            id="text-size-decrease"
            aria-label="Decrease text size"
            class="w-7 h-7 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-center transition-colors"
          >
            A-
          </button>
          <button
            type="button"
            id="text-size-reset"
            aria-label="Reset text size to standard"
            class="px-2 h-7 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-[11px] font-mono text-slate-600 dark:text-slate-400 flex items-center justify-center transition-colors"
          >
            100%
          </button>
          <button
            type="button"
            id="text-size-increase"
            aria-label="Increase text size"
            class="w-7 h-7 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-center transition-colors"
          >
            A+
          </button>
        </div>

        <div class="flex items-center gap-2" id="speech-toolbar">
          <button
            type="button"
            id="speech-toggle"
            aria-label="Listen to order read aloud"
            class="flex items-center gap-1.5 px-3 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-slate-700 dark:text-slate-300 transition-colors"
          >
            <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
            <span id="speech-toggle-label">Read Aloud</span>
          </button>
          <button
            type="button"
            id="speech-stop"
            aria-label="Stop reading aloud"
            class="hidden px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-rose-600 dark:text-rose-400 transition-colors"
          >
            Stop
          </button>
        </div>
      </div>

      <div
        id="order-text-content"
        class="prose prose-slate dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 font-serif leading-relaxed whitespace-pre-line text-sm sm:text-base selection:bg-amber-100 dark:selection:bg-amber-900/60"
      >
        {order.full_text || "The full primary source text for this executive order is currently being indexed."}
      </div>
    </article>

    <script>
      // Font-size zoom (A- / 100% / A+) persisted in localStorage
      (function () {
        const textEl = document.getElementById('order-text-content');
        if (!textEl) return;
        const SIZES = ['0.875rem', '1rem', '1.125rem', '1.25rem', '1.375rem'];
        const DEFAULT_IDX = 1;
        const KEY = 'eo-text-zoom';
        let currentIdx = DEFAULT_IDX;
        try {
          const stored = localStorage.getItem(KEY);
          if (stored !== null) currentIdx = Math.max(0, Math.min(SIZES.length - 1, parseInt(stored, 10)));
        } catch (e) {}

        function applySize() {
          textEl.style.fontSize = SIZES[currentIdx];
          const resetBtn = document.getElementById('text-size-reset');
          if (resetBtn) {
            const pct = [87, 100, 112, 125, 137][currentIdx];
            resetBtn.textContent = `${pct}%`;
          }
          try { localStorage.setItem(KEY, String(currentIdx)); } catch (e) {}
        }
        applySize();

        document.getElementById('text-size-decrease')?.addEventListener('click', () => {
          if (currentIdx > 0) { currentIdx--; applySize(); }
        });
        document.getElementById('text-size-increase')?.addEventListener('click', () => {
          if (currentIdx < SIZES.length - 1) { currentIdx++; applySize(); }
        });
        document.getElementById('text-size-reset')?.addEventListener('click', () => {
          currentIdx = DEFAULT_IDX; applySize();
        });
      })();

      // Client-side Web Speech API Read-Aloud
      (function () {
        const textEl = document.getElementById('order-text-content');
        const toggleBtn = document.getElementById('speech-toggle');
        const stopBtn = document.getElementById('speech-stop');
        const label = document.getElementById('speech-toggle-label');
        if (!textEl || !toggleBtn) return;

        const supportsSpeech = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
        if (!supportsSpeech) {
          const speechToolbar = document.getElementById('speech-toolbar');
          if (speechToolbar) speechToolbar.style.display = 'none';
          return;
        }

        let isPaused = false;
        let queue = [];
        let queueIndex = 0;

        function chunkText(text) {
          // Chrome speech synthesis fails silently on utterances > ~200 chars,
          // so split by sentence/newline chunks.
          return text
            .split(/(?<=[.?!])\s+|\n+/)
            .map(s => s.trim())
            .filter(s => s.length > 0 && !/^(\*|-|\d+\.)\s*$/.test(s));
        }

        function speakNext() {
          if (!window.speechSynthesis) return;
          if (queueIndex >= queue.length) {
            setSpeakingUI(false);
            return;
          }
          const utt = new SpeechSynthesisUtterance(queue[queueIndex]);
          utt.rate = 1.0;
          utt.pitch = 1.0;
          utt.onend = () => {
            queueIndex++;
            speakNext();
          };
          utt.onerror = () => {
            queueIndex++;
            speakNext();
          };
          window.speechSynthesis.speak(utt);
        }

        function setSpeakingUI(speaking) {
          if (label) label.textContent = speaking ? 'Pause' : 'Read Aloud';
          if (stopBtn) stopBtn.classList.toggle('hidden', !speaking);
          toggleBtn.classList.toggle('bg-blue-50', speaking);
          toggleBtn.classList.toggle('dark:bg-blue-950/40', speaking);
          toggleBtn.classList.toggle('border-blue-300', speaking);
        }

        toggleBtn.addEventListener('click', () => {
          if (!supportsSpeech) return;
          if (window.speechSynthesis.speaking && !window.speechSynthesis.paused) {
            window.speechSynthesis.pause();
            isPaused = true;
            if (label) label.textContent = 'Resume';
            return;
          }
          if (isPaused) {
            window.speechSynthesis.resume();
            isPaused = false;
            if (label) label.textContent = 'Pause';
            return;
          }
          window.speechSynthesis.cancel();
          queue = chunkText(textEl.innerText || textEl.textContent || '');
          queueIndex = 0;
          setSpeakingUI(true);
          speakNext();
        });

        stopBtn?.addEventListener('click', () => {
          if (!supportsSpeech) return;
          window.speechSynthesis.cancel();
          queue = [];
          queueIndex = 0;
          isPaused = false;
          setSpeakingUI(false);
        });

        window.addEventListener('beforeunload', () => {
          if (supportsSpeech) window.speechSynthesis.cancel();
        });
      })();
    </script>

    <!-- Referenced By Later Orders (reverse of the forward cross-references below) -->
    {referencedByLater.length > 0 && (
      <section class="mt-8 print:hidden">
        <h2 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-1">
          Referenced By Later Executive Orders
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          These later orders cite Executive Order {order.eo_number} by number in their text. Detected automatically from document text — always confirm current legal effect against the official Federal Register record.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {referencedByLater.map(o => (
            <div class="relative">
              <span class={`absolute top-3 right-3 z-10 text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full border ${relationBadgeClasses(o.relation)}`}>
                {o.relation}
              </span>
              <OrderCard order={o} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related Orders -->
    {relatedOrders.length > 0 && (
      <section class="mt-8 print:hidden">
        <h2 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-1">
          Related Executive Orders
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          {referencedCount > 0
            ? "Orders cross-referenced in this document's text, plus other orders from the same administration."
            : `Other executive orders signed by ${order.president_name}.`}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {relatedOrders.map(o => (
            <OrderCard order={o} />
          ))}
        </div>
      </section>
    )}

  </div>

  <script>
    document.querySelectorAll('[data-copy-anchor]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const anchorId = btn.getAttribute('data-copy-anchor');
        const url = `${window.location.origin}${window.location.pathname}#${anchorId}`;
        try {
          await navigator.clipboard.writeText(url);
          const svg = btn.querySelector('svg');
          if (svg) {
            const original = svg.outerHTML;
            svg.outerHTML = '<svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            setTimeout(() => {
              const currentSvg = btn.querySelector('svg');
              if (currentSvg) currentSvg.outerHTML = original;
            }, 1500);
          }
        } catch (e) {
          console.error('Failed to copy directive link:', e);
        }
      });
    });
  </script>
</Layout>
