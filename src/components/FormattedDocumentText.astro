---
import { parseDocumentBlocks } from '../lib/documentFormatter';

interface Props {
  text: string;
}

const { text } = Astro.props;
const blocks = parseDocumentBlocks(text || '');
---

{blocks.length === 0 ? (
  <p class="italic text-slate-400">The archival text for this order is not yet digitized.</p>
) : (
  <div class="space-y-4">
    {blocks.map((block) => {
      if (block.type === 'page_break') {
        return (
          <div class="my-6 flex items-center justify-center gap-3 select-none not-prose" aria-label={`Federal Register Page ${block.page}`}>
            <span class="h-px bg-slate-200 dark:bg-slate-800 flex-1"></span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/90 text-slate-500 dark:text-slate-400 font-mono text-[11px] shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-600"></span>
              FR Page {block.page}
            </span>
            <span class="h-px bg-slate-200 dark:bg-slate-800 flex-1"></span>
          </div>
        );
      }
      
      if (block.type === 'page_cluster') {
        return (
          <div class="my-6 p-4 rounded-xl border border-dashed border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 text-center select-none not-prose">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs font-mono font-medium text-slate-700 dark:text-slate-300 shadow-2xs">
              <span>📑</span>
              <span>Federal Register Pages {block.startPage}–{block.endPage} (Annex / Tabular Schedules)</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 max-w-md mx-auto font-sans">
              These pages comprise tabular annexes, tariff rate modifications, or graphic schedules in the printed Federal Register.
            </p>
          </div>
        );
      }

      if (block.type === 'heading') {
        return (
          <h3 class="font-sans font-bold text-sm sm:text-base tracking-wide uppercase text-slate-900 dark:text-slate-100 pt-3 border-b border-slate-100 dark:border-slate-800/60 pb-1">
            {block.text}
          </h3>
        );
      }

      if (block.type === 'filing_stamp') {
        return (
          <div class="mt-8 pt-4 border-t border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-500 dark:text-slate-400 not-prose bg-slate-50/60 dark:bg-slate-800/30 p-3.5 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-sm">🏛️</span>
              <span class="font-bold text-slate-700 dark:text-slate-300">Official NARA Filing:</span>
              <span>FR Doc. {block.doc}</span>
            </div>
            {block.billing && (
              <div class="text-[11px] text-slate-400 dark:text-slate-500">
                Billing Codes: {block.billing}
              </div>
            )}
          </div>
        );
      }

      return (
        <p class="leading-relaxed text-slate-800 dark:text-slate-200">
          {block.text}
        </p>
      );
    })}
  </div>
)}
