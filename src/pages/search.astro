---
import Layout from '../layouts/Layout.astro';
import orders from '../../data/site_orders_summary.json';

const totalIndexed = orders.length;
// Pass first 24 orders as initial preview before search is triggered
const initialOrders = orders.slice(0, 24);

// Keep in sync with TOPIC_PATTERNS / UNCATEGORIZED_TOPIC in scripts/topics.py
const TOPIC_OPTIONS = [
  "Agriculture",
  "Civil Rights & Liberties",
  "Criminal Justice & Law Enforcement",
  "Economy & Finance",
  "Education",
  "Energy & Environment",
  "Foreign Policy & Diplomacy",
  "Government Operations & Civil Service",
  "Healthcare & Public Health",
  "Housing",
  "Immigration & Border Security",
  "Infrastructure & Transportation",
  "Labor & Employment",
  "National Security & Defense",
  "Technology & Cybersecurity",
  "Trade & Tariffs",
  "Uncategorized",
];
---

<Layout 
  title="Search Executive Orders | Presidential Archive"
  description="Instant full-text search across all United States Presidential Executive Orders."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-8">
      <h1 class="font-serif font-extrabold text-3xl sm:text-4xl text-slate-900 dark:text-white">
        Search Executive Orders
      </h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
        Instant search across titles, presidential administrations, topics, and constitutional postures.
      </p>

      <!-- Search Input Box -->
      <div class="mt-6 relative max-w-xl mx-auto">
        <input 
          type="text" 
          id="search-input"
          autofocus
          placeholder="Type to search (e.g. defense, tariff, energy, lincoln, vaccines)..."
          class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-white dark:bg-slate-900 border-2 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-blue-500 shadow-sm text-base"
        />
        <div class="absolute left-4 top-4 text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
      </div>

      <div class="flex items-center justify-center gap-2 mt-3 text-xs text-slate-400">
        <span>Suggested:</span>
        <button class="suggest-btn text-blue-600 dark:text-blue-400 hover:underline">Lincoln</button>
        <span>•</span>
        <button class="suggest-btn text-blue-600 dark:text-blue-400 hover:underline">Defense</button>
        <span>•</span>
        <button class="suggest-btn text-blue-600 dark:text-blue-400 hover:underline">Tariff</button>
        <span>•</span>
        <button class="suggest-btn text-blue-600 dark:text-blue-400 hover:underline">Energy</button>
        <span>•</span>
        <button class="suggest-btn text-blue-600 dark:text-blue-400 hover:underline">Vaccine</button>
      </div>
    </div>

    <!-- Match Status -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500 mb-6 pb-2 border-b border-slate-200 dark:border-slate-800">
      <span id="search-status">Showing recent executive orders</span>
      <div class="flex items-center gap-3">
        <label for="topic-select" class="sr-only">Topic</label>
        <select
          id="topic-select"
          class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700 dark:text-slate-300"
        >
          <option value="">All Topics</option>
          {TOPIC_OPTIONS.map(topic => (
            <option value={topic}>{topic}</option>
          ))}
        </select>
        <label for="sort-select" class="sr-only">Sort By</label>
        <select
          id="sort-select"
          class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700 dark:text-slate-300"
        >
          <option value="relevance">Sort: Relevance</option>
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="longest">Longest (Word Count)</option>
          <option value="shortest">Shortest (Word Count)</option>
          <option value="friction">Most Constitutional Friction</option>
          <option value="fidelity">Most Constitutional Fidelity</option>
        </select>
        <span class="font-mono" id="total-count">{totalIndexed.toLocaleString()} total orders indexed</span>
      </div>
    </div>

    <!-- Search Results Container -->
    <div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Cards rendered here -->
    </div>

    <!-- Load More Matches Button -->
    <div id="load-more-container" class="hidden text-center mt-8 mb-6">
      <button 
        id="load-more-btn"
        class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow transition-colors"
      >
        Show More Matches
      </button>
    </div>

    <div id="empty-state" class="hidden text-center py-20 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 mt-4">
      <p class="text-slate-600 dark:text-slate-400 text-base font-serif">No executive orders found matching your search.</p>
      <p class="text-slate-400 text-xs mt-1">Try another keyword or search by president's name.</p>
    </div>

  </div>

  <script is:inline define:vars={{ initialOrders }}>
    const input = document.getElementById('search-input');
    const status = document.getElementById('search-status');
    const resultsGrid = document.getElementById('results-grid');
    const emptyState = document.getElementById('empty-state');
    const loadMoreContainer = document.getElementById('load-more-container');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const suggestBtns = document.querySelectorAll('.suggest-btn');
    const sortSelect = document.getElementById('sort-select');
    const topicSelect = document.getElementById('topic-select');

    let allOrders = null;
    let currentMatches = [];
    let displayedCount = 0;
    const PAGE_SIZE = 40;

    function getTopics(item) {
      if (Array.isArray(item.topics)) return item.topics;
      if (item.topic_tags_json) {
        try { return JSON.parse(item.topic_tags_json); } catch (e) { return []; }
      }
      return [];
    }

    function sortItems(list, sortMode) {
      if (!sortMode || sortMode === 'relevance') return list;
      const sorted = [...list];
      const getComp = o => (o.comp !== undefined ? o.comp : (o.sentiment_compound || 0));
      const getWords = o => (o.words !== undefined ? o.words : (o.word_count || 0));
      const getDateStr = o => (o.date || o.signing_date || '');
      switch (sortMode) {
        case 'oldest':
          sorted.sort((a, b) => getDateStr(a).localeCompare(getDateStr(b)));
          break;
        case 'longest':
          sorted.sort((a, b) => getWords(b) - getWords(a));
          break;
        case 'shortest':
          sorted.sort((a, b) => getWords(a) - getWords(b));
          break;
        case 'friction':
          sorted.sort((a, b) => getComp(a) - getComp(b));
          break;
        case 'fidelity':
          sorted.sort((a, b) => getComp(b) - getComp(a));
          break;
        case 'newest':
          sorted.sort((a, b) => getDateStr(b).localeCompare(getDateStr(a)));
          break;
      }
      return sorted;
    }

    function syncUrl(query) {
      const params = new URLSearchParams();
      if (query) params.set('q', query);
      if (topicSelect?.value) params.set('topic', topicSelect.value);
      if (sortSelect?.value && sortSelect.value !== 'relevance') params.set('sort', sortSelect.value);
      const qs = params.toString();
      const newUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.replaceState(null, '', newUrl);
    }

    function renderCard(order) {
      let sentimentBadge = {
        label: "Constitutional Neutral",
        bg: "bg-slate-100 dark:bg-slate-800",
        text: "text-slate-700 dark:text-slate-300",
        border: "border-slate-200 dark:border-slate-700"
      };

      const val = order.val || order.sentiment_valence;
      const comp = order.comp !== undefined ? order.comp : (order.sentiment_compound || 0);

      if (val === "Constitutional Fidelity" || val === "Positive") {
        sentimentBadge = {
          label: `Fidelity (${comp >= 0 ? '+' : ''}${comp.toFixed(2)})`,
          bg: "bg-emerald-50 dark:bg-emerald-950/40",
          text: "text-emerald-700 dark:text-emerald-300",
          border: "border-emerald-200 dark:border-emerald-800"
        };
      } else if (val === "Constitutional Friction / Overreach" || val === "Urgent/Negative") {
        sentimentBadge = {
          label: `Friction (${comp.toFixed(2)})`,
          bg: "bg-rose-50 dark:bg-rose-950/40",
          text: "text-rose-700 dark:text-rose-300",
          border: "border-rose-200 dark:border-rose-800"
        };
      }

      const rawDate = order.date || order.signing_date;
      const formattedDate = window.formatSigningDate ? window.formatSigningDate(rawDate) : (rawDate || "Undated");

      const num = order.num !== undefined ? order.num : order.eo_number;
      const eoBadge = num ? 
        `<span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900">EO ${num}</span>` :
        `<span class="font-mono text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">Order</span>`;

      const presName = order.pres || order.president_name;
      const slug = window.resolvePortraitSlug(order.slug || order.president_slug);
      const readTime = order.time || order.reading_time_minutes || 1;
      const wordCount = (order.words || order.word_count || 0).toLocaleString();
      const toneTag = order.tag || order.tone_tag;
      const snippet = order.snip || order.snippet;

      const metaObj = {
        id: order.id,
        num: order.num !== undefined ? order.num : order.eo_number,
        title: order.title,
        pres: presName,
        slug: order.slug || order.president_slug,
        date: rawDate,
        words: order.words || order.word_count || 0,
        time: readTime,
        val: val,
        comp: comp,
        tag: toneTag,
        snip: snippet
      };
      const compactMeta = JSON.stringify(metaObj).replace(/'/g, "&apos;");

      return `
        <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
              <div class="flex items-center gap-2">
                ${eoBadge}
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">${formattedDate}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full border ${sentimentBadge.bg} ${sentimentBadge.text} ${sentimentBadge.border}">
                  ${sentimentBadge.label}
                </span>
                <button type="button" data-bookmark-btn="${order.id}" data-order-meta='${compactMeta}' aria-label="Save this order" aria-pressed="false" class="p-1 rounded-md text-slate-400 hover:text-amber-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                </button>
              </div>
            </div>
            <h3 class="font-serif font-bold text-slate-900 dark:text-white text-base sm:text-lg mb-2 line-clamp-2 hover:text-blue-600 dark:hover:text-blue-400">
              <a href="/orders/${order.id}">${order.title}</a>
            </h3>
            ${toneTag ? `
              <div class="mb-3">
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-200 border border-amber-200 dark:border-amber-900/60 font-medium">
                  🏛️ ${toneTag}
                </span>
              </div>
            ` : ''}
            ${snippet ? `<p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">${snippet}</p>` : ''}
          </div>
          <div class="pt-3 mt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
            <div class="flex items-center gap-1.5 font-medium">
              <img src="/portraits/${slug}.jpg" alt="" class="w-5 h-5 rounded-full object-cover border border-slate-300 dark:border-slate-600" onerror="this.style.display='none'" />
              <span class="text-slate-700 dark:text-slate-300 truncate max-w-[140px] sm:max-w-none">${presName}</span>
            </div>
            <div class="flex items-center gap-2 font-mono text-[11px]">
              <span title="Estimated Reading Time">⏱ ${readTime}m</span>
              <span class="opacity-40">•</span>
              <span title="Word Count">${wordCount} words</span>
            </div>
          </div>
        </article>
      `;
    }

    function displayMatches(reset = false) {
      if (reset) {
        resultsGrid.innerHTML = '';
        displayedCount = 0;
      }

      const nextBatch = currentMatches.slice(displayedCount, displayedCount + PAGE_SIZE);
      if (nextBatch.length > 0) {
        resultsGrid.innerHTML += nextBatch.map(renderCard).join('');
        displayedCount += nextBatch.length;
        window.EOBookmarks?.refreshAllButtons();
      }

      if (displayedCount < currentMatches.length) {
        loadMoreContainer.classList.remove('hidden');
      } else {
        loadMoreContainer.classList.add('hidden');
      }

      if (currentMatches.length === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    async function loadIndex() {
      if (allOrders) return allOrders;
      try {
        const res = await fetch('/search_index.json');
        allOrders = await res.json();
        for (let i = 0; i < allOrders.length; i++) {
          const o = allOrders[i];
          const pres = o.pres || o.president_name || '';
          const num = o.num !== undefined ? String(o.num) : String(o.eo_number || '');
          const snip = o.snip || o.snippet || '';
          const tag = o.tag || o.tone_tag || '';
          const kw = o.kw || '';
          o._hay = `${o.title || ''} ${pres} ${num} ${snip} ${tag} ${kw}`.toLowerCase();
        }
      } catch (e) {
        console.error('Failed to load search index:', e);
        allOrders = initialOrders;
      }
      return allOrders;
    }

    async function performSearch(query, opts = {}) {
      const q = (query || '').toLowerCase().trim();
      const dataset = await loadIndex();
      const sortMode = sortSelect?.value || 'relevance';
      const topic = topicSelect?.value || '';

      if (!q) {
        currentMatches = topic ? dataset.filter(order => getTopics(order).includes(topic)) : dataset.slice(0, 40);
        currentMatches = sortItems(currentMatches, sortMode === 'relevance' ? 'newest' : sortMode);
        status.textContent = topic ? `Showing orders tagged "${topic}"` : 'Showing recent executive orders';
        displayMatches(true);
        if (!opts.skipUrlSync) syncUrl(query);
        return;
      }

      const terms = q.split(/\s+/).filter(Boolean);
      currentMatches = dataset.filter(order => {
        const hay = order._hay || `${order.title} ${order.pres || ''} ${order.num || ''}`.toLowerCase();
        const matchQ = terms.every(term => hay.includes(term));
        const matchTopic = !topic || getTopics(order).includes(topic);
        return matchQ && matchTopic;
      });
      currentMatches = sortItems(currentMatches, sortMode);

      status.textContent = `Found ${currentMatches.length.toLocaleString()} match${currentMatches.length === 1 ? '' : 'es'} for "${query}"`;
      displayMatches(true);
      if (!opts.skipUrlSync) syncUrl(query);
    }

    // Initialize with preview
    currentMatches = initialOrders;
    displayMatches(true);

    // Warm up search index in background
    setTimeout(loadIndex, 500);

    // Check URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    const initialSort = urlParams.get('sort');
    const initialTopic = urlParams.get('topic');
    if (initialSort && sortSelect) sortSelect.value = initialSort;
    if (initialTopic && topicSelect) topicSelect.value = initialTopic;
    if ((initialQuery || initialTopic) && input) {
      input.value = initialQuery || '';
      performSearch(initialQuery || '', { skipUrlSync: true });
    }

    let debounceTimer;
    input?.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(e.target.value);
      }, 150);
    });

    sortSelect?.addEventListener('change', () => {
      performSearch(input?.value || '');
    });

    topicSelect?.addEventListener('change', () => {
      performSearch(input?.value || '');
    });

    suggestBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (input) {
          input.value = btn.textContent.trim();
          performSearch(input.value);
        }
      });
    });

    loadMoreBtn?.addEventListener('click', () => {
      displayMatches(false);
    });
  </script>
</Layout>
