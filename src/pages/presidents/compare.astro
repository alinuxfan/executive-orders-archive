---
import Layout from '../../layouts/Layout.astro';
import { resolvePortraitSlug } from '../../lib/portraits';
import { formatPresidentNumbersHash } from '../../lib/presidentNumbers';
import { getYoungstownClassification } from '../../lib/youngstown';
import presidents from '../../../data/presidents.json';
import orders from '../../../data/site_orders_summary.json';

// Group orders by president slug to compute comparable per-president stats. Some
// harvest sources report a president identifier that doesn't match the canonical
// presidents.json slug (e.g. Clinton, Ford, Biden, G.H.W. Bush, and both Trump
// terms) — normalize through resolvePortraitSlug so those orders aren't silently
// dropped from their president's stats.
const presidentStats = new Map<string, { count: number; totalWords: number; totalSentiment: number; totalGrade: number; totalReadTime: number; z1: number; z2: number; z3: number }>();
for (const o of orders) {
  const slug = resolvePortraitSlug(o.president_slug);
  const cur = presidentStats.get(slug) || { count: 0, totalWords: 0, totalSentiment: 0, totalGrade: 0, totalReadTime: 0, z1: 0, z2: 0, z3: 0 };
  cur.count += 1;
  cur.totalWords += o.word_count || 0;
  cur.totalSentiment += o.sentiment_compound || 0;
  cur.totalGrade += o.flesch_kincaid_grade || 0;
  cur.totalReadTime += o.reading_time_minutes || 0;
  const z = getYoungstownClassification(o).zone;
  if (z === 1) cur.z1 += 1;
  else if (z === 2) cur.z2 += 1;
  else if (z === 3) cur.z3 += 1;
  presidentStats.set(slug, cur);
}

interface ComparableEntity {
  numbers: number[];
  name: string;
  slug: string;
  portraitSlug: string;
  party: string;
  terms: string[];
  orderCount: number;
  avgWordCount: number;
  avgReadingTime: number;
  avgSentiment: number;
  avgGrade: number;
  zone1Pct: number;
  zone3Pct: number;
  viewUrl: string;
  isSubTerm?: boolean;
}

const standardPresidents: ComparableEntity[] = presidents.map(p => {
  const stats = presidentStats.get(p.slug);
  const count = stats?.count || 0;
  return {
    numbers: p.numbers,
    name: p.name,
    slug: p.slug,
    portraitSlug: p.slug,
    party: p.party,
    terms: p.terms,
    orderCount: count,
    avgWordCount: count > 0 ? Math.round(stats!.totalWords / count) : 0,
    avgReadingTime: count > 0 ? Math.round(stats!.totalReadTime / count) : 0,
    avgSentiment: count > 0 ? Number((stats!.totalSentiment / count).toFixed(2)) : 0,
    avgGrade: count > 0 ? Number((stats!.totalGrade / count).toFixed(1)) : 0,
    zone1Pct: count > 0 ? Number(((stats!.z1 / count) * 100).toFixed(1)) : 0,
    zone3Pct: count > 0 ? Number(((stats!.z3 / count) * 100).toFixed(1)) : 0,
    viewUrl: `/presidents/${p.slug}`,
    isSubTerm: false
  };
}).filter(p => p.orderCount > 0);

// Sub-terms for non-consecutive presidents
function computeSubterm(slug: string, termId: string, name: string, terms: string[], filterUrl: string, predicate: (o: any) => boolean): ComparableEntity | null {
  const termOrders = orders.filter(o => resolvePortraitSlug(o.president_slug) === slug && predicate(o));
  const count = termOrders.length;
  if (count === 0) return null;
  const totalWords = termOrders.reduce((sum, o) => sum + (o.word_count || 0), 0);
  const totalSentiment = termOrders.reduce((sum, o) => sum + (o.sentiment_compound || 0), 0);
  const totalGrade = termOrders.reduce((sum, o) => sum + (o.flesch_kincaid_grade || 0), 0);
  const totalReadTime = termOrders.reduce((sum, o) => sum + (o.reading_time_minutes || 0), 0);
  let z1 = 0, z3 = 0;
  for (const o of termOrders) {
    const z = getYoungstownClassification(o).zone;
    if (z === 1) z1++;
    else if (z === 3) z3++;
  }
  const pres = presidents.find(p => p.slug === slug);
  return {
    numbers: [],
    name,
    slug: termId,
    portraitSlug: slug,
    party: pres?.party || "",
    terms,
    orderCount: count,
    avgWordCount: Math.round(totalWords / count),
    avgReadingTime: Math.round(totalReadTime / count),
    avgSentiment: Number((totalSentiment / count).toFixed(2)),
    avgGrade: Number((totalGrade / count).toFixed(1)),
    zone1Pct: Number(((z1 / count) * 100).toFixed(1)),
    zone3Pct: Number(((z3 / count) * 100).toFixed(1)),
    viewUrl: filterUrl,
    isSubTerm: true
  };
}

const subTerms: ComparableEntity[] = [
  computeSubterm('donald-trump', 'donald-trump-term-45', 'Donald Trump (45th Term: 2017–2021)', ['2017–2021'], '/orders?president=donald-trump&from=2017&to=2021', o => (o.date || o.signing_date || '') < '2025-01-20'),
  computeSubterm('donald-trump', 'donald-trump-term-47', 'Donald Trump (47th Term: 2025–present)', ['2025–present'], '/orders?president=donald-trump&from=2025', o => (o.date || o.signing_date || '') >= '2025-01-20'),
  computeSubterm('grover-cleveland', 'grover-cleveland-term-22', 'Grover Cleveland (22nd Term: 1885–1889)', ['1885–1889'], '/orders?president=grover-cleveland&from=1885&to=1889', o => (o.date || o.signing_date || '') < '1891-01-01'),
  computeSubterm('grover-cleveland', 'grover-cleveland-term-24', 'Grover Cleveland (24th Term: 1893–1897)', ['1893–1897'], '/orders?president=grover-cleveland&from=1893&to=1897', o => (o.date || o.signing_date || '') >= '1891-01-01'),
].filter((t): t is ComparableEntity => t !== null);

const comparablePresidents: ComparableEntity[] = [...standardPresidents, ...subTerms];

const compareJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Presidents", "item": new URL("/presidents", Astro.site).toString() },
    { "@type": "ListItem", "position": 3, "name": "Compare Presidents", "item": new URL("/presidents/compare", Astro.site).toString() }
  ]
};
---

<Layout
  title="Compare Presidents & Non-Consecutive Terms | Executive Orders Archive"
  description="Compare executive order output, average length, reading time, Youngstown separation of powers, and constitutional sentiment between any two US Presidents or non-consecutive administrations."
  structuredData={compareJsonLd}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/presidents" class="hover:underline">Presidents</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200">Compare</span>
    </nav>

    <!-- Header -->
    <div class="mb-8 text-center max-w-2xl mx-auto">
      <h1 class="font-serif font-extrabold text-3xl sm:text-4xl text-slate-900 dark:text-white">
        Compare Presidents & Administrations
      </h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
        Pick any two presidents or non-consecutive terms to compare their executive order output, document length, and Youngstown separation-of-powers alignment side by side.
      </p>
    </div>

    <!-- Selector Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8 max-w-3xl mx-auto">
      <div>
        <label for="president-a-select" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
          Entity A
        </label>
        <select
          id="president-a-select"
          class="w-full px-3.5 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
        >
          <optgroup label="Presidential Administrations (Overall)">
            {standardPresidents.map(p => (
              <option value={p.slug}>{p.name} ({formatPresidentNumbersHash(p.numbers)})</option>
            ))}
          </optgroup>
          {subTerms.length > 0 && (
            <optgroup label="Non-Consecutive Sub-Terms">
              {subTerms.map(t => (
                <option value={t.slug}>{t.name}</option>
              ))}
            </optgroup>
          )}
        </select>
      </div>
      <div>
        <label for="president-b-select" class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
          Entity B
        </label>
        <select
          id="president-b-select"
          class="w-full px-3.5 py-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 dark:text-white"
        >
          <optgroup label="Presidential Administrations (Overall)">
            {standardPresidents.map(p => (
              <option value={p.slug}>{p.name} ({formatPresidentNumbersHash(p.numbers)})</option>
            ))}
          </optgroup>
          {subTerms.length > 0 && (
            <optgroup label="Non-Consecutive Sub-Terms">
              {subTerms.map(t => (
                <option value={t.slug}>{t.name}</option>
              ))}
            </optgroup>
          )}
        </select>
      </div>
    </div>

    <!-- Same-selection quick toggle suggestion -->
    <div id="same-selection-alert" class="hidden max-w-3xl mx-auto mb-6 p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800 text-xs text-amber-900 dark:text-amber-200 flex items-center justify-between gap-3">
      <span>You have selected the same entity on both sides. Compare non-consecutive terms (e.g. Trump 45th vs 47th) or pick a different administration above.</span>
      <button id="quick-compare-terms-btn" class="px-3 py-1 rounded-md bg-amber-200 dark:bg-amber-800 font-semibold hover:underline flex-shrink-0">
        Compare Trump 45th vs 47th
      </button>
    </div>

    <!-- Comparison Panel -->
    <div id="compare-panel"></div>

  </div>

  <script define:vars={{ comparablePresidents }}>
    const dataset = comparablePresidents;
    const selectA = document.getElementById('president-a-select');
    const selectB = document.getElementById('president-b-select');
    const panel = document.getElementById('compare-panel');
    const sameSelectionAlert = document.getElementById('same-selection-alert');
    const quickCompareTermsBtn = document.getElementById('quick-compare-terms-btn');

    function escapeHtml(str) {
      if (typeof str !== 'string') return String(str ?? '');
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function findPresident(slug) {
      return dataset.find(p => p.slug === slug);
    }

    function metricRow(label, a, b, format = (v) => v, higherIsHighlighted = true) {
      const aWins = higherIsHighlighted && a > b;
      const bWins = higherIsHighlighted && b > a;
      return `
        <div class="grid grid-cols-3 items-center py-3 border-b border-slate-100 dark:border-slate-800 text-sm">
          <div class="text-right pr-4 font-mono font-bold ${aWins ? 'text-blue-600 dark:text-blue-400' : 'text-slate-700 dark:text-slate-300'}">${escapeHtml(format(a))}</div>
          <div class="text-center text-[11px] uppercase tracking-wider text-slate-400 font-semibold">${escapeHtml(label)}</div>
          <div class="text-left pl-4 font-mono font-bold ${bWins ? 'text-blue-600 dark:text-blue-400' : 'text-slate-700 dark:text-slate-300'}">${escapeHtml(format(b))}</div>
        </div>
      `;
    }

    function presidentHeader(p) {
      const portrait = p.portraitSlug || p.slug;
      return `
        <div class="flex flex-col items-center text-center gap-2">
          <img src="/portraits/${encodeURIComponent(portrait)}.jpg" alt="${escapeHtml(p.name)}" class="w-20 h-24 sm:w-24 sm:h-28 rounded-xl object-cover object-top border-2 border-amber-400 shadow-md" onerror="this.src='/portraits/default.svg'; this.onerror=null;" />
          <div>
            <div class="font-serif font-bold text-slate-900 dark:text-white text-base sm:text-lg">${escapeHtml(p.name)}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">${escapeHtml(p.party)}${p.terms && p.terms.length ? ' &bull; ' + escapeHtml(p.terms.join(', ')) : ''}</div>
          </div>
          <a href="${escapeHtml(p.viewUrl)}" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">View orders &rarr;</a>
        </div>
      `;
    }

    function render() {
      const a = findPresident(selectA.value);
      const b = findPresident(selectB.value);
      if (!a || !b) return;

      const isSame = a.slug === b.slug;
      if (sameSelectionAlert) {
        sameSelectionAlert.classList.toggle('hidden', !isSame);
      }

      panel.innerHTML = `
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
          <div class="grid grid-cols-3 items-start mb-6">
            <div>${presidentHeader(a)}</div>
            <div class="flex items-center justify-center h-full text-slate-300 dark:text-slate-700 font-serif font-black text-2xl">vs</div>
            <div>${presidentHeader(b)}</div>
          </div>
          <div class="mt-4">
            ${metricRow('Orders Tracked', a.orderCount, b.orderCount, (v) => v.toLocaleString())}
            ${metricRow('Avg Words / Order', a.avgWordCount, b.avgWordCount, (v) => v.toLocaleString())}
            ${metricRow('Avg Read Time', a.avgReadingTime, b.avgReadingTime, (v) => `${v} min`)}
            ${metricRow('Avg Flesch-Kincaid Grade', a.avgGrade, b.avgGrade, (v) => v.toFixed(1))}
            ${metricRow('Avg Constitutional Polarity', a.avgSentiment, b.avgSentiment, (v) => `${v >= 0 ? '+' : ''}${v.toFixed(2)}`)}
            ${metricRow('Youngstown Zone 1 (Statutory %)', a.zone1Pct, b.zone1Pct, (v) => `${v}%`)}
            ${metricRow('Youngstown Zone 3 (Friction %)', a.zone3Pct, b.zone3Pct, (v) => `${v}%`, false)}
          </div>
        </div>
      `;

      const url = new URL(window.location.href);
      url.searchParams.set('a', a.slug);
      url.searchParams.set('b', b.slug);
      window.history.replaceState({}, '', url);
    }

    quickCompareTermsBtn?.addEventListener('click', () => {
      if (selectA) selectA.value = 'donald-trump-term-45';
      if (selectB) selectB.value = 'donald-trump-term-47';
      render();
    });

    // Initialize from URL params, falling back to two illustrative defaults
    const params = new URLSearchParams(window.location.search);
    const defaultA = params.get('a') && findPresident(params.get('a')) ? params.get('a') : (dataset.find(p => p.slug === 'abraham-lincoln')?.slug || dataset[0]?.slug);
    const defaultB = params.get('b') && findPresident(params.get('b')) ? params.get('b') : (dataset.find(p => p.slug === 'donald-trump')?.slug || dataset[1]?.slug);

    if (defaultA) selectA.value = defaultA;
    if (defaultB) selectB.value = defaultB;

    selectA.addEventListener('change', render);
    selectB.addEventListener('change', render);

    render();
  </script>
</Layout>
