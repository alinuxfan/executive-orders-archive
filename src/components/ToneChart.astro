---
interface Props {
  positiveCount: number;
  neutralCount: number;
  urgentCount: number;
  totalOrders: number;
}

const { positiveCount, neutralCount, urgentCount, totalOrders } = Astro.props;

const posPct = totalOrders > 0 ? Math.round((positiveCount / totalOrders) * 100) : 0;
const neuPct = totalOrders > 0 ? Math.round((neutralCount / totalOrders) * 100) : 0;
const urgPct = totalOrders > 0 ? Math.round((urgentCount / totalOrders) * 100) : 0;
---

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h3 class="font-serif font-bold text-slate-900 dark:text-white text-lg flex items-center gap-2">
        <span>⚖️</span>
        Constitutional Alignment & Sentiment
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Evaluated strictly through the U.S. Constitution (Articles I–VII) & Amendments from an Early Statesman's prism
      </p>
    </div>
    <span class="text-xs font-mono px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold">
      {totalOrders} Scored
    </span>
  </div>

  <!-- Segmented Progress Bar -->
  <div class="w-full h-5 rounded-full overflow-hidden flex shadow-inner bg-slate-100 dark:bg-slate-800 mb-6">
    <div 
      style={`width: ${posPct}%`} 
      class="bg-emerald-500 hover:bg-emerald-600 transition-all cursor-pointer relative group" 
      title={`Constitutional Fidelity: ${positiveCount} (${posPct}%)`}
    ></div>
    <div 
      style={`width: ${neuPct}%`} 
      class="bg-amber-400 hover:bg-amber-500 transition-all cursor-pointer relative group" 
      title={`Constitutional Neutral: ${neutralCount} (${neuPct}%)`}
    ></div>
    <div 
      style={`width: ${urgPct}%`} 
      class="bg-rose-500 hover:bg-rose-600 transition-all cursor-pointer relative group" 
      title={`Constitutional Friction / Overreach: ${urgentCount} (${urgPct}%)`}
    ></div>
  </div>

  <!-- Legend & Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
    
    <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50/60 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
      <div class="w-3.5 h-3.5 rounded bg-emerald-500 mt-0.5 flex-shrink-0"></div>
      <div>
        <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">
          {positiveCount} <span class="text-xs font-normal text-slate-500">({posPct}%)</span>
        </div>
        <div class="font-semibold text-emerald-700 dark:text-emerald-400">Constitutional Fidelity</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Art. II §3 faithful statutory execution & civil liberty protection</div>
      </div>
    </div>

    <div class="flex items-start gap-3 p-3 rounded-lg bg-amber-50/60 dark:bg-amber-950/20 border border-amber-100 dark:border-amber-900/40">
      <div class="w-3.5 h-3.5 rounded bg-amber-400 mt-0.5 flex-shrink-0"></div>
      <div>
        <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">
          {neutralCount} <span class="text-xs font-normal text-slate-500">({neuPct}%)</span>
        </div>
        <div class="font-semibold text-amber-700 dark:text-amber-400">Constitutional Neutral</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Routine departmental administration, civil service, executive seals</div>
      </div>
    </div>

    <div class="flex items-start gap-3 p-3 rounded-lg bg-rose-50/60 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/40">
      <div class="w-3.5 h-3.5 rounded bg-rose-500 mt-0.5 flex-shrink-0"></div>
      <div>
        <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">
          {urgentCount} <span class="text-xs font-normal text-slate-500">({urgPct}%)</span>
        </div>
        <div class="font-semibold text-rose-700 dark:text-rose-400">Friction & Overreach</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Art. I purse/commerce tension, 10th Amend federalism, property takings</div>
      </div>
    </div>

  </div>
</div>
