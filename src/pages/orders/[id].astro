---
import Layout from '../../layouts/Layout.astro';
import CitationBox from '../../components/CitationBox.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import OrderCard from '../../components/OrderCard.astro';
import FramersPerspective from '../../components/FramersPerspective.astro';
import ConstitutionalFrictionScorecard from '../../components/ConstitutionalFrictionScorecard.astro';
import FormattedDocumentText from '../../components/FormattedDocumentText.astro';
import { generateOrderSummary, isGenericBoilerplate, buildOrderMetaDescription } from '../../lib/summary';
import { getRelatedOrders, getReferencedByLater } from '../../lib/relatedOrders';
import { resolvePortraitSlug } from '../../lib/portraits';
import { formatSigningDate } from '../../lib/dates';
import { getYoungstownClassification } from '../../lib/youngstown';
import { readingLevelLabel, eoLabel, cleanOrderTitle, statusBadgeClasses, parseDisposition, relationLabel } from '../../lib/orderLabels';
import rawOrders from '../../../data/site_orders.json';

export async function getStaticPaths() {
  return rawOrders.map(order => ({
    params: { id: order.id },
    props: { order }
  }));
}

const { order } = Astro.props;

// Plain English summary and directives fallback
const fallbackSummary = generateOrderSummary({
  title: order.title,
  president_name: order.president_name,
  signing_date: order.signing_date,
  full_text: order.full_text || "",
  sentiment_valence: order.sentiment_valence,
  word_count: order.word_count
});

// Use database-backed constitutional evaluations when available
let directives = fallbackSummary.keyDirectives;
if (order.key_directives_json) {
  try {
    const parsed = JSON.parse(order.key_directives_json);
    if (Array.isArray(parsed) && parsed.length > 0) {
      const isBoilerplate = parsed.every((d) => isGenericBoilerplate(d?.description) || isGenericBoilerplate(d?.title));
      if (!isBoilerplate) {
        directives = parsed;
      }
    }
  } catch (e) {}
}

let affectedEntities = fallbackSummary.whoItAffects;
if (order.who_it_affects_json) {
  try {
    const parsed = JSON.parse(order.who_it_affects_json);
    if (Array.isArray(parsed) && parsed.length > 0) {
      affectedEntities = parsed;
    }
  } catch (e) {}
}

let topicTags: string[] = [];
if (Array.isArray(order.topic_tags)) {
  topicTags = order.topic_tags;
} else if (order.topic_tags_json) {
  try {
    const parsed = JSON.parse(order.topic_tags_json);
    if (Array.isArray(parsed)) topicTags = parsed;
  } catch (e) {}
}

let rawSummaryText = order.summary_plain_english || fallbackSummary.plainEnglish;
if (isGenericBoilerplate(rawSummaryText)) {
  rawSummaryText = fallbackSummary.plainEnglish;
}
const summaryParagraphs = rawSummaryText.replace(/\\n/g, "\n").split("\n\n").filter(p => p.trim().length > 0);

// Format date
const formattedDate = order.signing_date ? formatSigningDate(order.signing_date, {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric"
}) : "Date not specified";

// Youngstown Three-Tier Framework
const youngstown = getYoungstownClassification(order);

// Sentiment badge
let sentimentColor = {
  bg: "bg-slate-100 dark:bg-slate-800",
  text: "text-slate-700 dark:text-slate-300",
  border: "border-slate-300 dark:border-slate-700"
};

if (order.sentiment_valence === "Constitutional Fidelity" || order.sentiment_valence === "Positive") {
  sentimentColor = {
    bg: "bg-emerald-50 dark:bg-emerald-950/40",
    text: "text-emerald-700 dark:text-emerald-300",
    border: "border-emerald-300 dark:border-emerald-800"
  };
} else if (order.sentiment_valence === "Constitutional Friction / Overreach" || order.sentiment_valence === "Urgent/Negative") {
  sentimentColor = {
    bg: "bg-rose-50 dark:bg-rose-950/40",
    text: "text-rose-700 dark:text-rose-300",
    border: "border-rose-300 dark:border-rose-800"
  };
}

const orderLabel = eoLabel(order);
const disposition = parseDisposition(order.disposition_json);
const orderStatus = disposition?.status || null;
const statusRelations = (disposition?.inbound || []).filter(r => r.relation !== 'continued');
const outboundRelations = disposition?.outbound || [];

// The generated summary opens "Signed by President X on <date>, this order
// concerns <title>." followed by the order's own operative text; the meta
// description reuses that operative text as its novel-keyword tail.
const cleanTitle = cleanOrderTitle(order.title);
const summaryLead = summaryParagraphs[0] || '';
const leadSentenceEnd = cleanTitle ? summaryLead.indexOf(`${cleanTitle.replace(/\.$/, '')}.`) : -1;
// LLM-written summaries (scripts/llm_summarize.py) lead directly with what the order does.
const operativeText = summaryLead.startsWith('Signed by President')
  ? (leadSentenceEnd !== -1 ? summaryLead.slice(leadSentenceEnd + cleanTitle.replace(/\.$/, '').length + 1).trim() : '')
  : summaryLead;

const metaDescription = buildOrderMetaDescription({
  title: order.title,
  eo_number: orderLabel || null,
  status: orderStatus,
  operative_text: operativeText,
  president_name: order.president_name,
  signing_date: order.signing_date,
  word_count: order.word_count,
  topic_tags: topicTags
});

const orderCanonicalUrl = new URL(`/orders/${order.id}`, Astro.site).toString();
const portraitSlug = resolvePortraitSlug(order.president_slug);

const compactMeta = JSON.stringify({
  id: order.id,
  num: order.eo_number,
  sfx: order.eo_suffix || undefined,
  st: orderStatus || undefined,
  title: order.title,
  pres: order.president_name,
  slug: order.president_slug,
  date: order.signing_date,
  words: order.word_count,
  time: order.reading_time_minutes,
  val: order.sentiment_valence,
  comp: order.sentiment_compound,
  tag: order.tone_tag,
  zone: youngstown.zone,
  snip: summaryParagraphs[0] || ''
});

const legislationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Legislation",
  "name": order.title,
  "legislationIdentifier": orderLabel ? `EO ${orderLabel}` : order.id,
  ...(order.fr_citation ? { "isPartOf": { "@type": "Periodical", "name": "Federal Register", "identifier": order.fr_citation } } : {}),
  ...(orderStatus === 'Revoked' || orderStatus === 'Superseded' ? { "legislationLegalForce": "NotInForce" } : orderStatus && orderStatus.startsWith('Partially') ? { "legislationLegalForce": "PartiallyInForce" } : {}),
  "legislationType": order.eo_number ? "Executive Order" : "Presidential Order",
  "legislationDate": order.signing_date || undefined,
  "datePublished": order.signing_date || undefined,
  "legislationJurisdiction": "United States",
  "author": {
    "@type": "Person",
    "name": order.president_name
  },
  "description": metaDescription,
  "url": orderCanonicalUrl,
  "inLanguage": "en-US"
};

// Related Orders: cross-referenced EO numbers mentioned in the text, plus same-president orders
// signed closest in time, as a fallback / supplement.
const { related: relatedOrders, referencedCount } = getRelatedOrders(order);
const referencedByLater = getReferencedByLater(order);

function relationBadgeClasses(relation: string): string {
  if (relation === 'Revokes' || relation === 'Rescinds' || relation === 'Supersedes') {
    return 'bg-rose-600 text-white border-rose-700';
  }
  if (relation === 'Amends') {
    return 'bg-amber-500 text-white border-amber-600';
  }
  return 'bg-slate-600 text-white border-slate-700';
}

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Orders", "item": new URL("/orders", Astro.site).toString() },
    { "@type": "ListItem", "position": 3, "name": order.title, "item": orderCanonicalUrl }
  ]
};
---

<Layout 
  title={`${order.title} | Executive Orders Archive`}
  description={metaDescription}
  image={portraitSlug !== "default" ? `/portraits/${portraitSlug}.jpg` : "/og-default.png"}
  type="article"
  structuredData={[legislationJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    
    <!-- Top Breadcrumb & Quick Actions -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/orders" class="hover:underline">Orders</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-mono">
          {orderLabel ? `EO ${orderLabel}` : 'Order'}
        </span>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Print / Save / Share -->
        <button
          type="button"
          data-print-btn
          aria-label="Print or save as PDF"
          title="Print or save as PDF"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-semibold transition-colors print:hidden"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a1 1 0 001-1v-5H8v5a1 1 0 001 1zm8-12V5a1 1 0 00-1-1H8a1 1 0 00-1 1v4h10z"></path></svg>
          <span>Print / PDF</span>
        </button>
        <button
          type="button"
          data-bookmark-btn={order.id}
          data-order-meta={compactMeta}
          aria-label="Save this order"
          aria-pressed="false"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-semibold transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
          <span data-bookmark-label>Save</span>
        </button>
        <ShareButtons 
          url={`/orders/${order.id}`} 
          title={order.title}
          eoNumber={order.eo_number}
          presidentName={order.president_name}
          signingDate={order.signing_date}
          youngstownZone={youngstown.zone}
          youngstownName={youngstown.name}
          constitutionalValence={order.sentiment_valence}
          sentimentCompound={order.sentiment_compound}
        />
      </div>
    </div>

    <!-- Document Header -->
    <header class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 mb-8 shadow-sm">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        {orderLabel ? (
          <span class="font-mono text-sm font-bold px-2.5 py-1 rounded bg-blue-100 text-blue-900 dark:bg-blue-950 dark:text-blue-200 border border-blue-200 dark:border-blue-900">
            Executive Order {orderLabel}
          </span>
        ) : (
          <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            Presidential Order
          </span>
        )}
        {orderStatus && (
          <a href="#legal-status" class={`text-xs font-bold uppercase tracking-wide px-2.5 py-1 rounded border ${statusBadgeClasses(orderStatus)}`} title="Federal Register disposition status">
            {orderStatus}
          </a>
        )}
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${youngstown.badgeClass}`} title={youngstown.tagline}>
          {youngstown.icon} {youngstown.name}
        </span>
        <span
          class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${sentimentColor.bg} ${sentimentColor.text} ${sentimentColor.border}`}
          title="Automated keyword-pattern score from -1 to +1 (see About → methodology). It measures the wording of the text, not a legal judgment."
        >
          {order.sentiment_valence} ({order.sentiment_compound >= 0 ? '+' : ''}{order.sentiment_compound.toFixed(2)})
        </span>
      </div>

      <h1 class="font-serif font-extrabold text-2xl sm:text-3xl lg:text-4xl text-slate-900 dark:text-white leading-tight mb-4">
        {order.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-500 dark:text-slate-400 pt-4 border-t border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-2 font-medium text-slate-800 dark:text-slate-200">
          <img
            src={`/portraits/${portraitSlug}.jpg`}
            alt={order.president_name}
            class="w-6 h-6 rounded-full object-cover border border-slate-300 dark:border-slate-600"
            onerror="this.style.display='none'"
          />
          {portraitSlug !== 'default' ? (
            <a href={`/presidents/${portraitSlug}`} class="hover:underline">
              {order.president_name}
            </a>
          ) : (
            <span>{order.president_name}</span>
          )}
        </div>
        <span>•</span>
        <div class="font-mono">{formattedDate}</div>
        <span>•</span>
        <div>{order.reading_time_minutes} min read ({order.word_count.toLocaleString()} words)</div>
        {order.fr_citation && (
          <>
            <span>•</span>
            <div class="font-mono" title="Federal Register citation">{order.fr_citation.replace(' FR ', ' Fed. Reg. ')}</div>
          </>
        )}
      </div>
    </header>

    <!-- Legal status from Federal Register disposition tables -->
    {disposition && (statusRelations.length > 0 || outboundRelations.length > 0) && (
      <section
        id="legal-status"
        class={`scroll-mt-24 rounded-2xl p-5 sm:p-6 mb-8 border shadow-sm ${orderStatus === 'Revoked' || orderStatus === 'Superseded' || orderStatus === 'Suspended'
          ? 'bg-rose-50 dark:bg-rose-950/30 border-rose-200 dark:border-rose-900/60'
          : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800'}`}
      >
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <h2 class="font-serif font-bold text-lg text-slate-900 dark:text-white">Legal Status & Amendment History</h2>
          {orderStatus && (
            <span class={`text-[11px] font-bold uppercase tracking-wide px-2 py-0.5 rounded border ${statusBadgeClasses(orderStatus)}`}>{orderStatus}</span>
          )}
        </div>
        {orderStatus === 'Revoked' || orderStatus === 'Superseded' ? (
          <p class="text-sm text-rose-900 dark:text-rose-200 mb-4">
            This order is no longer in effect according to the Federal Register's executive order disposition tables.
          </p>
        ) : orderStatus === 'Reinstated' ? (
          <p class="text-sm text-slate-700 dark:text-slate-300 mb-4">This order was revoked and later reinstated by a subsequent order.</p>
        ) : null}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
          {statusRelations.length > 0 && (
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Actions on this order</h3>
              <ul class="space-y-1.5">
                {statusRelations.map(rel => (
                  <li class="text-slate-700 dark:text-slate-300">
                    <span class="font-semibold">{relationLabel(rel, 'inbound')}</span>{' '}
                    {rel.id ? <a href={`/orders/${rel.id}`} class="font-mono text-blue-600 dark:text-blue-400 hover:underline">EO {rel.eo}</a> : <span class="font-mono">EO {rel.eo}</span>}
                    {rel.date && <span class="text-slate-500 dark:text-slate-400"> ({rel.date})</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {outboundRelations.length > 0 && (
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">What this order changed</h3>
              <ul class="space-y-1.5">
                {outboundRelations.slice(0, 12).map(rel => (
                  <li class="text-slate-700 dark:text-slate-300">
                    <span class="font-semibold">{relationLabel(rel, 'outbound')}</span>{' '}
                    {rel.id ? <a href={`/orders/${rel.id}`} class="font-mono text-blue-600 dark:text-blue-400 hover:underline">EO {rel.eo}</a> : <span class="font-mono">EO {rel.eo}</span>}
                    {rel.date && <span class="text-slate-500 dark:text-slate-400"> ({rel.date})</span>}
                  </li>
                ))}
                {outboundRelations.length > 12 && (
                  <li class="text-xs text-slate-500 dark:text-slate-400">and {outboundRelations.length - 12} more</li>
                )}
              </ul>
            </div>
          )}
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-4">
          Source: Office of the Federal Register executive order disposition notes. Orders before 1994 show only actions recorded by later orders.
        </p>
      </section>
    )}

    <!-- Plain-English Translation & Constitutional Analysis Callout -->
    <section class="bg-amber-50/50 dark:bg-amber-950/20 border-2 border-amber-200/80 dark:border-amber-900/40 rounded-2xl p-6 sm:p-8 mb-8 shadow-sm">
      <div class="flex items-center gap-3 mb-4">
        <div class="p-2 rounded-xl bg-amber-100 dark:bg-amber-900/50 text-amber-900 dark:text-amber-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
          <h2 class="font-serif font-bold text-lg text-slate-900 dark:text-white">
            Plain-English Translation & Framers' Constitutional Analysis
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Early Statesman synthesis distilling legal jargon into practical meaning, statutory anchors, and structural constitutional impacts.
          </p>
        </div>
      </div>

      <div class="space-y-4 mb-6">
        {summaryParagraphs.map(p => {
          const isCallout = p.startsWith("CONSTITUTIONAL") || p.startsWith("EXECUTIVE POWERS") || p.startsWith("STATUTORY") || p.startsWith("Constitutional Assessment:");
          return isCallout ? (
            <div class="p-4 rounded-xl bg-amber-100/60 dark:bg-amber-900/30 border border-amber-300/50 dark:border-amber-800/50 text-xs font-mono text-amber-950 dark:text-amber-200 leading-relaxed">
              {p}
            </div>
          ) : (
            <p class="text-slate-800 dark:text-slate-200 text-base leading-relaxed font-normal">
              {p}
            </p>
          );
        })}
      </div>

      <!-- Key Directives -->
      <div class="space-y-3 mb-6">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Key Directives & Operative Actions
        </h3>
        <div class="grid grid-cols-1 gap-2.5">
          {directives.map((d, idx) => {
            const anchorId = `directive-${idx + 1}`;
            return (
              <div id={anchorId} class="scroll-mt-24 group relative p-3.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 text-sm text-slate-700 dark:text-slate-300 flex items-start gap-3 target:ring-2 target:ring-amber-400">
                <span class="text-amber-500 font-bold mt-0.5">▪</span>
                <div class="flex-1">
                  {d.title && !d.title.startsWith("Directive") && !d.title.startsWith("Operative Mandate") && (
                    <div class="font-semibold text-slate-900 dark:text-white mb-1 text-xs uppercase tracking-wide text-amber-700 dark:text-amber-400">
                      {d.title}
                    </div>
                  )}
                  <p class="leading-relaxed">{d.description}</p>
                </div>
                <button
                  type="button"
                  data-copy-anchor={anchorId}
                  aria-label="Copy link to this directive"
                  title="Copy link to this directive"
                  class="flex-shrink-0 opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity text-slate-400 hover:text-amber-500"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5"></path></svg>
                </button>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Who It Affects -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
          Constitutional & Societal Entities Impacted
        </h3>
        <div class="flex flex-wrap gap-2">
          {affectedEntities.map(entity => (
            <span class="px-3 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-200 shadow-2xs">
              🏛️ {entity}
            </span>
          ))}
        </div>
      </div>

      <!-- Policy Areas & Topics -->
      {topicTags.length > 0 && (
        <div class="mt-4 pt-4 border-t border-amber-200/60 dark:border-amber-900/40">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
            Policy Areas & Topics
          </h3>
          <div class="flex flex-wrap gap-2">
            {topicTags.map(topic => (
              <a
                href={`/orders?topic=${encodeURIComponent(topic)}`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-amber-100/70 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-800 dark:text-slate-200 transition-colors shadow-2xs"
              >
                <span>🏷️</span>
                <span>{topic}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- The Framers' Constitutional Council (Madison, Hamilton, Mason & Youngstown Framework) -->
    <FramersPerspective order={order} youngstown={youngstown} />

    <!-- Five Measurable Constitutional Friction Dimensions Audit -->
    <ConstitutionalFrictionScorecard order={order} />

    <!-- Quantitative Metrics Panel -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      
      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1">Total Words</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.word_count.toLocaleString()}
        </div>
        <div class="text-[10px] text-slate-500 mt-1">{order.char_count.toLocaleString()} characters</div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1">Estimated Read Time</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.reading_time_minutes} <span class="text-xs font-sans font-normal">min</span>
        </div>
        <div class="text-[10px] text-slate-500 mt-1">@ 200 words / min</div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1">Flesch-Kincaid</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.flesch_kincaid_grade}
        </div>
        <div class="text-[10px] text-slate-500 mt-1">{readingLevelLabel(order.flesch_kincaid_grade)}</div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border border-slate-200 dark:border-slate-800 text-center">
        <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold mb-1" title="Automated keyword-pattern score from -1 to +1 (see About → methodology). It measures the wording of the text, not a legal judgment.">Language Tone Score</div>
        <div class="text-2xl font-bold font-mono text-slate-900 dark:text-white">
          {order.sentiment_compound >= 0 ? '+' : ''}{order.sentiment_compound.toFixed(2)}
        </div>
        <div class="text-[10px] text-slate-500 mt-1 font-mono uppercase">{order.sentiment_valence}</div>
        <a href="/about#constitutional-sentiment" class="text-[10px] text-blue-600 dark:text-blue-400 hover:underline print:hidden">How is this scored?</a>
      </div>

    </section>

    <!-- Reader Controls: Text Size & Read Aloud -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 mb-6 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400 print:hidden">
      <div class="flex items-center gap-2">
        <span class="font-medium text-slate-700 dark:text-slate-300">Text size:</span>
        <div class="inline-flex rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 bg-slate-50 dark:bg-slate-800">
          <button type="button" data-text-size="sm" class="px-2 py-0.5 rounded text-[11px] font-mono hover:bg-white dark:hover:bg-slate-700">A-</button>
          <button type="button" data-text-size="base" class="px-2 py-0.5 rounded text-[11px] font-mono bg-white dark:bg-slate-700 font-bold shadow-2xs">A</button>
          <button type="button" data-text-size="lg" class="px-2 py-0.5 rounded text-[11px] font-mono hover:bg-white dark:hover:bg-slate-700">A+</button>
          <button type="button" data-text-size="xl" class="px-2 py-0.5 rounded text-[11px] font-mono hover:bg-white dark:hover:bg-slate-700">A++</button>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="tts-toggle-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors"
        >
          <svg id="tts-icon-play" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <svg id="tts-icon-stop" class="w-3.5 h-3.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path></svg>
          <span id="tts-label">Read Aloud</span>
        </button>
      </div>
    </div>

    <!-- Official Full Document Body -->
    <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-10 mb-10 shadow-sm">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-4 mb-6 flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Official Archival Text</h2>
        {order.source_url && (
          <a href={order.source_url} target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
            <span>View Source Document</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        )}
      </div>

      <div id="order-body-text" class="prose dark:prose-invert max-w-none text-base leading-relaxed font-serif text-slate-800 dark:text-slate-200 space-y-4">
        <FormattedDocumentText text={order.full_text} />
      </div>
    </article>

    <!-- Cross-Reference Network: Referenced By Later Orders -->
    {referencedByLater.length > 0 && (
      <section class="mb-10 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-base">🔗</span>
          <h2 class="font-serif font-bold text-lg text-slate-900 dark:text-white">
            Referenced By Later Executive Orders ({referencedByLater.length})
          </h2>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          Subsequent presidents who cited, amended, continued, or revoked this directive in later orders.
        </p>

        <div class="divide-y divide-slate-100 dark:divide-slate-800 border-t border-slate-100 dark:border-slate-800">
          {referencedByLater.map(item => (
            <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class={`font-mono text-[10px] font-bold px-2 py-0.5 rounded border ${relationBadgeClasses(item.relation)}`}>
                  {item.relation}
                </span>
                <a href={`/orders/${item.id}`} class="text-sm font-serif font-semibold text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 line-clamp-1">
                  {item.title}
                </a>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 flex-shrink-0">
                <span>{item.president_name || item.pres}</span>
                <span>•</span>
                <span class="font-mono">{item.signing_date || item.date}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related Orders (Cross-referenced in text, or same president) -->
    {relatedOrders.length > 0 && (
      <section class="mb-10">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="font-serif font-bold text-lg text-slate-900 dark:text-white">
              Related Executive Orders
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              {referencedCount > 0
                ? `${referencedCount} order${referencedCount === 1 ? '' : 's'} cited directly in this text, plus related actions from this administration.`
                : `Other executive actions signed by ${order.president_name} around this period.`}
            </p>
          </div>
          <a href={`/presidents/${portraitSlug}`} class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
            All by this President &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedOrders.map(ro => (
            <OrderCard order={ro} />
          ))}
        </div>
      </section>
    )}

    <!-- Academic Citation Helper -->
    <CitationBox order={order} />

  </div>

  <script is:inline>
    // Text size adjuster
    const orderBody = document.getElementById('order-body-text');
    const sizeButtons = document.querySelectorAll('[data-text-size]');
    const sizeClasses = {
      sm: ['text-sm', 'leading-normal'],
      base: ['text-base', 'leading-relaxed'],
      lg: ['text-lg', 'leading-relaxed'],
      xl: ['text-xl', 'leading-loose']
    };

    sizeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-text-size');
        if (!orderBody || !sizeClasses[size]) return;
        
        // Remove all size classes
        Object.values(sizeClasses).flat().forEach(c => orderBody.classList.remove(c));
        // Add new size classes
        sizeClasses[size].forEach(c => orderBody.classList.add(c));

        // Update active button styling
        sizeButtons.forEach(b => {
          b.classList.remove('bg-white', 'dark:bg-slate-700', 'font-bold', 'shadow-2xs');
        });
        btn.classList.add('bg-white', 'dark:bg-slate-700', 'font-bold', 'shadow-2xs');
      });
    });

    // Directive permalink copy buttons
    document.querySelectorAll('[data-copy-anchor]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const anchorId = btn.getAttribute('data-copy-anchor');
        const url = new URL(window.location.href);
        url.hash = anchorId;
        try {
          await navigator.clipboard.writeText(url.toString());
          const origHtml = btn.innerHTML;
          btn.innerHTML = '<span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-sans font-bold">Copied!</span>';
          setTimeout(() => { btn.innerHTML = origHtml; }, 1800);
        } catch (e) {}
      });
    });

    // Text-to-Speech (Web Speech API)
    const ttsBtn = document.getElementById('tts-toggle-btn');
    const playIcon = document.getElementById('tts-icon-play');
    const stopIcon = document.getElementById('tts-icon-stop');
    const ttsLabel = document.getElementById('tts-label');

    if ('speechSynthesis' in window && ttsBtn) {
      let isSpeaking = false;

      function stopSpeech() {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        playIcon?.classList.remove('hidden');
        stopIcon?.classList.add('hidden');
        if (ttsLabel) ttsLabel.textContent = 'Read Aloud';
      }

      ttsBtn.addEventListener('click', () => {
        if (isSpeaking) {
          stopSpeech();
          return;
        }

        const textToRead = orderBody?.textContent?.slice(0, 5000) || '';
        if (!textToRead) return;

        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(textToRead);
        utterance.rate = 1.0;
        utterance.pitch = 1.0;

        utterance.onend = () => { stopSpeech(); };
        utterance.onerror = () => { stopSpeech(); };

        window.speechSynthesis.speak(utterance);
        isSpeaking = true;
        playIcon?.classList.add('hidden');
        stopIcon?.classList.remove('hidden');
        if (ttsLabel) ttsLabel.textContent = 'Stop';
      });

      window.addEventListener('beforeunload', () => {
        window.speechSynthesis.cancel();
      });
    } else if (ttsBtn) {
      ttsBtn.style.display = 'none';
    }

    // Print button
    document.querySelector('[data-print-btn]')?.addEventListener('click', () => {
      window.print();
    });
  </script>
</Layout>
