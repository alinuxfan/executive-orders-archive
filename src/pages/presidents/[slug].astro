---
import Layout from '../../layouts/Layout.astro';
import OrderCard from '../../components/OrderCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ToneChart from '../../components/ToneChart.astro';
import { resolvePortraitSlug } from '../../lib/portraits';
import { formatPresidentNumbers, calculateYearsInOffice } from '../../lib/presidentNumbers';
import { getYoungstownClassification } from '../../lib/youngstown';
import presidents from '../../../data/presidents.json';
import allOrders from '../../../data/site_orders_summary.json';

export async function getStaticPaths() {
  return presidents.map(president => ({
    params: { slug: president.slug },
    props: { president }
  }));
}

const { president } = Astro.props;

// Filter orders for this president. Some harvest sources report a president
// identifier that doesn't match the canonical presidents.json slug (e.g. Clinton,
// Ford, Biden, G.H.W. Bush, and both Trump terms) — resolvePortraitSlug maps those
// known aliases back to the canonical slug before comparing.
const presOrders = allOrders.filter(o => resolvePortraitSlug(o.slug || o.president_slug) === president.slug);

const totalOrders = presOrders.length;
const totalWords = presOrders.reduce((sum, o) => sum + (o.words !== undefined ? o.words : (o.word_count || 0)), 0);
const avgWords = totalOrders > 0 ? Math.round(totalWords / totalOrders) : 0;
const avgReadingTime = totalOrders > 0 ? Math.round(presOrders.reduce((sum, o) => sum + (o.time !== undefined ? o.time : (o.reading_time_minutes || 0)), 0) / totalOrders) : 0;
const avgSentiment = totalOrders > 0 ? (presOrders.reduce((sum, o) => sum + (o.comp !== undefined ? o.comp : (o.sentiment_compound || 0)), 0) / totalOrders).toFixed(2) : "0.00";

const positiveCount = presOrders.filter(o => {
  const v = o.val || o.sentiment_valence;
  return v === "Constitutional Fidelity" || v === "Positive";
}).length;

const neutralCount = presOrders.filter(o => {
  const v = o.val || o.sentiment_valence;
  return v === "Constitutional Neutral" || v === "Neutral" || !v;
}).length;

const urgentCount = presOrders.filter(o => {
  const v = o.val || o.sentiment_valence;
  return v === "Constitutional Friction / Overreach" || v === "Urgent/Negative";
}).length;

// Youngstown Separation of Powers Breakdown
let pZone1 = 0;
let pZone2 = 0;
let pZone3 = 0;

for (const o of presOrders) {
  const z = getYoungstownClassification(o).zone;
  if (z === 1) pZone1++;
  else if (z === 2) pZone2++;
  else if (z === 3) pZone3++;
}

const pZone1Pct = totalOrders > 0 ? ((pZone1 / totalOrders) * 100).toFixed(1) : "0.0";
const pZone2Pct = totalOrders > 0 ? ((pZone2 / totalOrders) * 100).toFixed(1) : "0.0";
const pZone3Pct = totalOrders > 0 ? ((pZone3 / totalOrders) * 100).toFixed(1) : "0.0";

// Calculate years in office & Washington Multiplier (handles multi-term & ongoing terms)
const yearsInOffice = calculateYearsInOffice(president.terms);
const annualRate = yearsInOffice > 0 ? (totalOrders / yearsInOffice) : 0;
const washingtonMultiplier = annualRate / 1.0;

// Party styling
const partyColors: Record<string, { bg: string; text: string; border: string }> = {
  "Republican": { bg: "bg-red-50 dark:bg-red-950/40", text: "text-red-700 dark:text-red-400", border: "border-red-200 dark:border-red-900" },
  "Democrat": { bg: "bg-blue-50 dark:bg-blue-950/40", text: "text-blue-700 dark:text-blue-400", border: "border-blue-200 dark:border-blue-900" },
  "Democratic-Republican": { bg: "bg-emerald-50 dark:bg-emerald-950/40", text: "text-emerald-700 dark:text-emerald-400", border: "border-emerald-200 dark:border-emerald-900" },
  "Federalist": { bg: "bg-amber-50 dark:bg-amber-950/40", text: "text-amber-700 dark:text-amber-400", border: "border-amber-200 dark:border-amber-900" },
  "Whig": { bg: "bg-purple-50 dark:bg-purple-950/40", text: "text-purple-700 dark:text-purple-400", border: "border-purple-200 dark:border-purple-900" },
  "Unaffiliated": { bg: "bg-slate-50 dark:bg-slate-900", text: "text-slate-700 dark:text-slate-400", border: "border-slate-200 dark:border-slate-800" },
};
const partyStyle = partyColors[president.party] || partyColors["Unaffiliated"];

const presidentCanonicalUrl = new URL(`/presidents/${president.slug}`, Astro.site).toString();

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": president.name,
  "jobTitle": "President of the United States",
  "image": new URL(`/portraits/${president.slug}.jpg`, Astro.site).toString(),
  "url": presidentCanonicalUrl,
  "affiliation": president.party
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Presidents", "item": new URL("/presidents", Astro.site).toString() },
    { "@type": "ListItem", "position": 3, "name": president.name, "item": presidentCanonicalUrl }
  ]
};
---

<Layout
  title={`${president.name} - Executive Orders`}
  description={`Analysis, reading times, and sentiment scoring for all Executive Orders issued by President ${president.name}.`}
  image={`/portraits/${president.slug}.jpg`}
  structuredData={[personJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Breadcrumb -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-mono">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/presidents" class="hover:underline">Presidents</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">{president.name}</span>
      </nav>
      <ShareButtons 
        url={`/presidents/${president.slug}`} 
        title={`${president.name} - Executive Orders`}
        presidentName={president.name}
        presidentStats={{
          multiplier: washingtonMultiplier.toFixed(1),
          zone1Pct: pZone1Pct,
          zone3Pct: pZone3Pct,
          totalOrders: totalOrders
        }}
      />
    </div>

    <!-- President Profile Header Banner -->
    <header class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 mb-8 shadow-sm">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8">
        
        <!-- Large Official Portrait -->
        <div class="relative w-32 h-40 sm:w-40 sm:h-52 rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border-2 border-amber-400 shadow-md flex-shrink-0">
          <img 
            src={`/portraits/${president.slug}.jpg`} 
            alt={`Official portrait of ${president.name}`}
            class="w-full h-full object-cover object-top"
            onerror="this.src='/portraits/default.svg'; this.onerror=null;"
          />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-2 text-center">
            <span class="text-xs font-bold text-amber-300 font-mono tracking-wider">
              {formatPresidentNumbers(president.numbers)} President
            </span>
          </div>
        </div>

        <!-- Bio & Meta -->
        <div class="flex-grow text-center sm:text-left">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-2">
            <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full border ${partyStyle.bg} ${partyStyle.text} ${partyStyle.border}`}>
              {president.party}
            </span>
            <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
              Terms: {president.terms.join(", ")}
            </span>
          </div>

          <h1 class="font-serif font-extrabold text-3xl sm:text-4xl text-slate-900 dark:text-white mb-4">
            {president.name}
          </h1>

          <!-- Summary Metric Cards -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 text-center">
              <div class="text-[11px] text-slate-400 uppercase font-semibold">Orders Tracked</div>
              <div class="text-xl font-bold font-serif text-slate-900 dark:text-white mt-0.5">{totalOrders}</div>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 text-center">
              <div class="text-[11px] text-slate-400 uppercase font-semibold">Avg Words / Order</div>
              <div class="text-xl font-bold font-serif text-slate-900 dark:text-white mt-0.5">{avgWords.toLocaleString()}</div>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 text-center">
              <div class="text-[11px] text-slate-400 uppercase font-semibold">Avg Read Time</div>
              <div class="text-xl font-bold font-serif text-slate-900 dark:text-white mt-0.5">~{avgReadingTime} min</div>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 text-center">
              <div class="text-[11px] text-slate-400 uppercase font-semibold">Avg Sentiment</div>
              <div class="text-xl font-bold font-serif text-emerald-600 dark:text-emerald-400 mt-0.5">
                {Number(avgSentiment) >= 0 ? '+' : ''}{avgSentiment}
              </div>
            </div>
          </div>
        </div>

      </div>
    </header>

    <!-- Separation of Powers & Youngstown Profile -->
    {totalOrders > 0 ? (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
        
        <!-- Youngstown Separation of Powers Card -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class="text-lg">⚖️</span>
                <h2 class="font-serif font-bold text-lg text-slate-900 dark:text-white">
                  Youngstown Separation of Powers
                </h2>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                1952 Standard
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
              Distribution of orders across Justice Jackson's constitutional tiers:
            </p>

            <!-- Stacked bar -->
            <div class="w-full h-3.5 rounded-full overflow-hidden flex bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 mb-4 shadow-inner">
              <div style={`width: ${pZone1Pct}%`} class="h-full bg-emerald-500" title={`Zone 1: ${pZone1} orders (${pZone1Pct}%)`}></div>
              <div style={`width: ${pZone2Pct}%`} class="h-full bg-amber-400" title={`Zone 2: ${pZone2} orders (${pZone2Pct}%)`}></div>
              <div style={`width: ${pZone3Pct}%`} class="h-full bg-rose-500" title={`Zone 3: ${pZone3} orders (${pZone3Pct}%)`}></div>
            </div>

            <!-- 3 Columns -->
            <div class="grid grid-cols-3 gap-2 text-center text-xs">
              <div class="p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60">
                <div class="font-bold text-emerald-800 dark:text-emerald-300 text-sm">{pZone1Pct}%</div>
                <div class="text-[10px] text-emerald-700 dark:text-emerald-400 font-medium">Zone 1 ({pZone1})</div>
                <div class="text-[9px] text-slate-400 mt-0.5">Statutory Authorization</div>
              </div>

              <div class="p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60">
                <div class="font-bold text-amber-800 dark:text-amber-300 text-sm">{pZone2Pct}%</div>
                <div class="text-[10px] text-amber-700 dark:text-amber-400 font-medium">Zone 2 ({pZone2})</div>
                <div class="text-[9px] text-slate-400 mt-0.5">Zone of Twilight</div>
              </div>

              <div class="p-2.5 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/60">
                <div class="font-bold text-rose-800 dark:text-rose-300 text-sm">{pZone3Pct}%</div>
                <div class="text-[10px] text-rose-700 dark:text-rose-400 font-medium">Zone 3 ({pZone3})</div>
                <div class="text-[9px] text-slate-400 mt-0.5">Lowest Ebb / Friction</div>
              </div>
            </div>
          </div>

          <!-- Washington Multiplier comparison callout -->
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-500">Washington Rate Multiplier:</span>
            <span class="font-mono font-bold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/50 px-2 py-0.5 rounded">
              {washingtonMultiplier.toFixed(1)}× Washington Baseline
            </span>
          </div>
        </div>

        <!-- ToneChart Card -->
        <ToneChart 
          positiveCount={positiveCount}
          neutralCount={neutralCount}
          urgentCount={urgentCount}
          totalOrders={totalOrders}
        />

      </div>
    ) : null}

    <!-- Orders Section -->
    <div>
      <h2 class="font-serif font-bold text-2xl text-slate-900 dark:text-white mb-6">
        Executive Orders Issued ({totalOrders})
      </h2>

      {totalOrders > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {presOrders.map(order => (
            <OrderCard order={order} />
          ))}
        </div>
      ) : (
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-10 border border-slate-200 dark:border-slate-800 text-center">
          <p class="text-slate-500 dark:text-slate-400 text-sm max-w-md mx-auto leading-relaxed">
            Historical orders for this presidency are currently queued in the background ingest pipeline. Run the historical harvester to load all records from the National Archives and UCSB.
          </p>
        </div>
      )}
    </div>

  </div>
</Layout>
