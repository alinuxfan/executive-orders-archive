# Executive Orders Archive - Environment Variables Template
# Copy this file to .env.local for local overrides.
# NOTE: Never commit sensitive keys or credentials to version control.

# Example public site URL (used during build)
SITE_URL=https://executiveordersarchive.org

# Optional custom donation URLs (defaults to https://buymeacoffee.com/alinuxfan, https://ko-fi.com/alinuxfan, and https://github.com/sponsors/alinuxfan)
# PUBLIC_BUYMEACOFFEE_URL=https://buymeacoffee.com/YOUR_USERNAME
# PUBLIC_KOFI_URL=https://ko-fi.com/YOUR_USERNAME
# PUBLIC_GITHUB_SPONSORS_URL=https://github.com/sponsors/YOUR_USERNAME
