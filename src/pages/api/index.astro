---
import Layout from '../../layouts/Layout.astro';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "API", "item": new URL("/api", Astro.site).toString() }
  ]
};

const exampleOrder = {
  id: "fr-2026-19335",
  eo_number: 14428,
  title: "Executive Order — Example Title",
  president_name: "…",
  signing_date: "2026-01-15",
  sentiment: { compound: 0.12, positive: 0.2, negative: 0.05, neutral: 0.75, valence: "Constitutional Fidelity" },
  tone_tag: "Art. II §3: Faithful Execution of Statutory Law",
  topics: ["Energy & Environment", "Economy & Finance"],
  url: "https://executiveordersarchive.org/orders/fr-2026-19335"
};
---

<Layout
  title="Developer API"
  description="Free, unauthenticated JSON endpoints for the Executive Orders Archive dataset — bulk listing and per-order detail."
  structuredData={breadcrumbJsonLd}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200">API</span>
    </nav>

    <h1 class="font-serif font-extrabold text-3xl sm:text-4xl text-slate-900 dark:text-white mb-4">
      Developer API
    </h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-10 leading-relaxed">
      The same dataset that powers this site, available as free, unauthenticated, static JSON. No API
      key, no rate limit beyond what a static file host imposes — these are plain files served from
      Cloudflare's edge, not a server.
    </p>

    <section class="mb-10">
      <h2 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-3">Endpoints</h2>

      <div class="mb-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900">GET</span>
          <code class="text-sm font-mono text-slate-800 dark:text-slate-200">/api/orders.json</code>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Bulk listing of every order: id, EO number, title, president, dates, word count, sentiment,
          tone tag, and topic tags. No full document text — use the per-order endpoint for that.
        </p>
      </div>

      <div class="mb-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900">GET</span>
          <code class="text-sm font-mono text-slate-800 dark:text-slate-200">/api/orders/{'{id}'}.json</code>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-2">
          Full detail for a single order — full document text, plain-English summary, key directives,
          affected entities, and all metrics. <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">{'{id}'}</code>
          is the same slug used in this site's own <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">/orders/{'{id}'}</code> URLs
          (and appears in every <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">id</code> field in the bulk listing above).
        </p>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Example: <a href="/api/orders/fr-2026-19335.json" class="text-blue-600 dark:text-blue-400 hover:underline font-mono">/api/orders/fr-2026-19335.json</a>
        </p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-3">Example response</h2>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed mb-3">
        Shape of a single order from the per-order endpoint (truncated):
      </p>
      <pre class="text-xs font-mono bg-slate-950 text-slate-200 rounded-xl p-4 overflow-x-auto">{JSON.stringify(exampleOrder, null, 2)}</pre>
    </section>

    <section class="mb-10">
      <h2 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-3">Update frequency & caching</h2>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        These files are regenerated whenever the underlying dataset changes and this site is rebuilt —
        in practice, roughly twice per weekday as new executive orders are synced from the Federal
        Register. They're served with a one-hour cache header; if you need fresher data than that,
        poll <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">/api/orders.json</code> and diff against your own copy.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-3">License & attribution</h2>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed mb-3">
        Executive order text and official metadata are U.S. government works in the <strong>public
        domain</strong>. The derived fields — sentiment scores, tone tags, topic tags, plain-English
        summaries — are generated by this project's automated pipeline; see
        <a href="/about" class="text-blue-600 dark:text-blue-400 hover:underline">About &amp; Methodology</a>
        for exactly how, and its limitations. There's no legal requirement to credit this project, but
        a link back to <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">executiveordersarchive.org</code> is appreciated.
      </p>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        This is an independent, unofficial project — not affiliated with the U.S. government. Treat
        the derived analytical fields as a research starting point, not a legal authority.
      </p>
    </section>

  </div>
</Layout>
