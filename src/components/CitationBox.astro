---
interface Props {
  order: {
    id: string;
    eo_number?: number | null;
    eo_suffix?: string | null;
    title: string;
    president_name: string;
    signing_date?: string;
    fr_citation?: string | null;
  };
}

const { order } = Astro.props;

const dateObj = order.signing_date ? new Date(order.signing_date) : null;
const year = dateObj ? dateObj.getUTCFullYear() : 'n.d.';
const monthName = dateObj ? dateObj.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }) : '';
const fullMonthName = dateObj ? dateObj.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' }) : '';
const day = dateObj ? dateObj.getUTCDate() : '';

// Bluebook T12 month abbreviations
const BLUEBOOK_MONTHS = ['Jan.', 'Feb.', 'Mar.', 'Apr.', 'May', 'June', 'July', 'Aug.', 'Sept.', 'Oct.', 'Nov.', 'Dec.'];
const bluebookDate = dateObj ? `${BLUEBOOK_MONTHS[dateObj.getUTCMonth()]} ${day}, ${year}` : 'n.d.';
// Bluebook rule 6.2(a): numbers of five or more digits take commas; four-digit numbers don't.
const bluebookNumber = (n: number | string) => {
  const digits = String(n);
  return digits.length >= 5 ? Number(digits).toLocaleString('en-US') : digits;
};

const eoNumberLabel = order.eo_number ? `${order.eo_number}${order.eo_suffix ? `-${order.eo_suffix}` : ''}` : '';
const bluebookEo = order.eo_number ? `${bluebookNumber(order.eo_number)}${order.eo_suffix ? `-${order.eo_suffix}` : ''}` : '';

// "91 FR 60501" -> volume 91, page 60501
const frMatch = (order.fr_citation || '').match(/^(\d+)\s*FR\s*(\d+)$/);
const bluebookReporter = frMatch ? `${frMatch[1]} Fed. Reg. ${bluebookNumber(frMatch[2])}` : '';

const canonicalUrl = `https://executiveordersarchive.org/orders/${order.id}`;
// Unnumbered orders: title without the redundant "Executive Order —" prefix.
const untitledTitle = order.title.replace(/^Executive Order\s*[—–-]?\s*/i, '').trim();

// Bluebook (rule 14.7): Exec. Order No. 14,431, 91 Fed. Reg. 60,501 (Sept. 18, 2026).
// Orders without a Federal Register citation (pre-1936 or unpublished) cite the date and an online source.
const bluebookCitation = order.eo_number
  ? bluebookReporter
    ? `Exec. Order No. ${bluebookEo}, ${bluebookReporter} (${bluebookDate}).`
    : `Exec. Order No. ${bluebookEo} (${bluebookDate}), ${canonicalUrl}.`
  : `Exec. Order${untitledTitle ? `, ${untitledTitle}` : ''} (${bluebookDate}), ${canonicalUrl}.`;

// APA 7th Edition (legal materials follow Bluebook form)
const apaCitation = order.eo_number
  ? bluebookReporter
    ? `Exec. Order No. ${order.eo_number}${order.eo_suffix ? `-${order.eo_suffix}` : ''}, ${frMatch?.[1]} Fed. Reg. ${frMatch?.[2]} (${year}). ${canonicalUrl}`
    : `U.S. President (${order.president_name}). (${year}, ${fullMonthName} ${day}). Executive Order ${eoNumberLabel}: ${order.title}. Executive Orders Archive. ${canonicalUrl}`
  : `U.S. President (${order.president_name}). (${year}, ${fullMonthName} ${day}). ${order.title} [Executive Order]. Executive Orders Archive. ${canonicalUrl}`;

// Chicago 17th Edition
const chicagoCitation = order.eo_number
  ? `U.S. President. Executive Order ${eoNumberLabel}, "${order.title}." ${fullMonthName} ${day}, ${year}.${frMatch ? ` ${frMatch[1]} Fed. Reg. ${frMatch[2]}.` : ''} ${canonicalUrl}.`
  : `U.S. President. "${order.title}." Executive Order signed by ${order.president_name}, ${fullMonthName} ${day}, ${year}. Executive Orders Archive. ${canonicalUrl}.`;

// BibTeX
const bibtexKey = `eo_${order.id.replace(/[^a-zA-Z0-9_]/g, '_')}`;
const bibtexCitation = `@misc{${bibtexKey},
  author       = {{${order.president_name}}},
  title        = {{${order.eo_number ? `Executive Order ${eoNumberLabel}: ` : ''}${order.title}}},
  year         = {${year}},
  month        = {${monthName.toLowerCase()}},
  day          = {${day}},
  howpublished = {\\url{${canonicalUrl}}},
  note         = {Executive Orders Archive}
}`;
---

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm mb-8">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-4 pb-3 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <span class="text-lg">📜</span>
      <h3 class="font-serif font-bold text-base text-slate-900 dark:text-white">
        Scholarly & Legal Citations
      </h3>
    </div>
    
    <!-- Format Selector Buttons -->
    <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl text-xs font-semibold print:hidden" id="citation-tabs">
      <button class="cit-tab active px-3 py-1 rounded-lg bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-300 shadow-xs" data-target="bluebook">Bluebook</button>
      <button class="cit-tab px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white" data-target="apa">APA</button>
      <button class="cit-tab px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white" data-target="chicago">Chicago</button>
      <button class="cit-tab px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white" data-target="bibtex">BibTeX</button>
    </div>
  </div>

  <!-- Citation Text Display -->
  <div class="relative bg-slate-50 dark:bg-slate-950/60 rounded-xl p-4 border border-slate-200 dark:border-slate-800">
    <pre id="citation-content" class="text-xs sm:text-sm font-mono text-slate-800 dark:text-slate-200 whitespace-pre-wrap leading-relaxed select-all overflow-x-auto">{bluebookCitation}</pre>

    <!-- Copy Button -->
    <button
      id="copy-citation-btn"
      class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow transition-all print:hidden"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
      <span id="copy-btn-label">Copy Citation</span>
    </button>
  </div>
</div>

<script is:inline define:vars={{ bluebookCitation, apaCitation, chicagoCitation, bibtexCitation }}>
  const citations = {
    bluebook: bluebookCitation,
    apa: apaCitation,
    chicago: chicagoCitation,
    bibtex: bibtexCitation
  };

  const tabs = document.querySelectorAll('.cit-tab');
  const content = document.getElementById('citation-content');
  const copyBtn = document.getElementById('copy-citation-btn');
  const btnLabel = document.getElementById('copy-btn-label');

  let activeFormat = 'bluebook';

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active', 'bg-white', 'dark:bg-slate-700', 'text-blue-600', 'dark:text-blue-300', 'shadow-xs');
        t.classList.add('text-slate-600', 'dark:text-slate-400');
      });

      tab.classList.add('active', 'bg-white', 'dark:bg-slate-700', 'text-blue-600', 'dark:text-blue-300', 'shadow-xs');
      tab.classList.remove('text-slate-600', 'dark:text-slate-400');

      activeFormat = tab.getAttribute('data-target');
      if (content) {
        content.textContent = citations[activeFormat];
      }
    });
  });

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(citations[activeFormat]);
      if (btnLabel) btnLabel.textContent = '✓ Copied to Clipboard!';
      copyBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
      copyBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
      setTimeout(() => {
        if (btnLabel) btnLabel.textContent = 'Copy Citation';
        copyBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
        copyBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
      }, 2000);
    } catch (e) {
      console.error('Failed to copy citation:', e);
    }
  });
</script>
