---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Saved Executive Orders"
  description="Your personal reading list of saved Executive Orders, stored locally in your browser."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200">Saved Orders</span>
    </nav>

    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <h1 class="font-serif font-extrabold text-3xl sm:text-4xl text-slate-900 dark:text-white">
          Saved Executive Orders
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-2xl">
          Your personal reading list. Saved orders are stored locally in your browser (via
          <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded font-mono">localStorage</code>) —
          nothing is sent to a server.
        </p>
      </div>

      <div class="flex items-center gap-2" id="export-controls">
        <button
          id="export-json-btn"
          type="button"
          aria-label="Export saved orders as JSON"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          <span>Export JSON</span>
        </button>
        <button
          id="export-csv-btn"
          type="button"
          aria-label="Export saved orders as CSV"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>Export CSV</span>
        </button>
      </div>
    </div>

    <div id="saved-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>

    <div id="saved-empty" class="hidden text-center py-20 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
      <p class="text-slate-600 dark:text-slate-400 text-base font-serif mb-1">You haven't saved any orders yet.</p>
      <p class="text-slate-400 text-xs mb-4">Click the bookmark icon on any order to add it to this list.</p>
      <a href="/orders" class="inline-block px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold">
        Browse All Orders
      </a>
    </div>

    <div id="saved-loading" class="text-center py-20 text-sm text-slate-400">
      Loading your saved orders&hellip;
    </div>

  </div>

  <script>
    const grid = document.getElementById('saved-grid');
    const empty = document.getElementById('saved-empty');
    const loading = document.getElementById('saved-loading');
    const exportJsonBtn = document.getElementById('export-json-btn');
    const exportCsvBtn = document.getElementById('export-csv-btn');
    const exportControls = document.getElementById('export-controls');

    let currentSavedOrders = [];

    function renderCard(order) {
      let sentimentBadge = {
        label: "Constitutional Neutral",
        bg: "bg-slate-100 dark:bg-slate-800",
        text: "text-slate-700 dark:text-slate-300",
        border: "border-slate-200 dark:border-slate-700"
      };

      const val = order.val || order.sentiment_valence;
      const comp = order.comp !== undefined ? order.comp : (order.sentiment_compound || 0);

      if (val === "Constitutional Fidelity" || val === "Positive") {
        sentimentBadge = {
          label: `Fidelity (${comp >= 0 ? '+' : ''}${comp.toFixed(2)})`,
          bg: "bg-emerald-50 dark:bg-emerald-950/40",
          text: "text-emerald-700 dark:text-emerald-300",
          border: "border-emerald-200 dark:border-emerald-800"
        };
      } else if (val === "Constitutional Friction / Overreach" || val === "Urgent/Negative") {
        sentimentBadge = {
          label: `Friction (${comp.toFixed(2)})`,
          bg: "bg-rose-50 dark:bg-rose-950/40",
          text: "text-rose-700 dark:text-rose-300",
          border: "border-rose-200 dark:border-rose-800"
        };
      }

      const rawDate = order.date || order.signing_date;
      const formattedDate = window.formatSigningDate ? window.formatSigningDate(rawDate) : (rawDate || "Undated");

      const num = order.num !== undefined ? order.num : order.eo_number;
      const eoBadge = num ?
        `<span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900">EO ${num}</span>` :
        `<span class="font-mono text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">Order</span>`;

      const presName = order.pres || order.president_name;
      const slug = window.resolvePortraitSlug(order.slug || order.president_slug);
      const readTime = order.time || order.reading_time_minutes || 1;
      const wordCount = (order.words || order.word_count || 0).toLocaleString();
      const snippet = order.snip || order.snippet;

      return `
        <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200 flex flex-col justify-between" data-saved-card="${order.id}">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
              <div class="flex items-center gap-2">
                ${eoBadge}
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">${formattedDate}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full border ${sentimentBadge.bg} ${sentimentBadge.text} ${sentimentBadge.border}">
                  ${sentimentBadge.label}
                </span>
                <button type="button" data-bookmark-btn="${order.id}" aria-label="Remove from saved orders" aria-pressed="true" class="p-1 rounded-md text-amber-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                </button>
              </div>
            </div>
            <h3 class="font-serif font-bold text-slate-900 dark:text-white text-base sm:text-lg mb-2 line-clamp-2 hover:text-blue-600 dark:hover:text-blue-400">
              <a href="/orders/${order.id}">${order.title}</a>
            </h3>
            ${snippet ? `<p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">${snippet}</p>` : ''}
          </div>
          <div class="pt-3 mt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
            <div class="flex items-center gap-1.5 font-medium">
              <img src="/portraits/${slug}.jpg" alt="" class="w-5 h-5 rounded-full object-cover border border-slate-300 dark:border-slate-600" onerror="this.style.display='none'" />
              <span class="text-slate-700 dark:text-slate-300 truncate max-w-[140px] sm:max-w-none">${presName}</span>
            </div>
            <div class="flex items-center gap-2 font-mono text-[11px]">
              <span title="Estimated Reading Time">⏱ ${readTime}m</span>
              <span class="opacity-40">•</span>
              <span title="Word Count">${wordCount} words</span>
            </div>
          </div>
        </article>
      `;
    }

    async function render() {
      const savedIds = window.EOBookmarks ? window.EOBookmarks.getAll() : [];

      if (savedIds.length === 0) {
        currentSavedOrders = [];
        loading.classList.add('hidden');
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        if (exportControls) exportControls.classList.add('hidden');
        return;
      }

      if (exportControls) exportControls.classList.remove('hidden');

      // Check if we have compact metadata cached in localStorage for immediate 0ms rendering
      const metaMap = window.EOBookmarks?.getMetadataMap ? window.EOBookmarks.getMetadataMap() : {};
      const missingIds = savedIds.filter(id => !metaMap[id]);

      if (missingIds.length === 0) {
        // Instant local render!
        currentSavedOrders = savedIds.map(id => metaMap[id]);
        loading.classList.add('hidden');
        empty.classList.add('hidden');
        grid.innerHTML = currentSavedOrders.map(renderCard).join('');
        window.EOBookmarks?.refreshAllButtons();
        return;
      }

      // If any metadata is missing, backfill from search_index.json
      try {
        const res = await fetch('/search_index.json');
        const allOrders = await res.json();
        const byId = new Map(allOrders.map(o => [o.id, o]));

        currentSavedOrders = [];
        for (const id of savedIds) {
          let item = metaMap[id];
          if (!item && byId.has(id)) {
            const raw = byId.get(id);
            item = {
              id: raw.id,
              num: raw.num !== undefined ? raw.num : raw.eo_number,
              title: raw.title,
              pres: raw.pres || raw.president_name,
              slug: raw.slug || raw.president_slug,
              date: raw.date || raw.signing_date,
              words: raw.words || raw.word_count || 0,
              time: raw.time || raw.reading_time_minutes || 1,
              val: raw.val || raw.sentiment_valence,
              comp: raw.comp !== undefined ? raw.comp : (raw.sentiment_compound || 0),
              tag: raw.tag || raw.tone_tag,
              snip: raw.snip || raw.snippet
            };
            window.EOBookmarks?.saveMetadata?.(id, item);
          }
          if (item) currentSavedOrders.push(item);
        }

        loading.classList.add('hidden');
        if (currentSavedOrders.length === 0) {
          grid.innerHTML = '';
          empty.classList.remove('hidden');
        } else {
          empty.classList.add('hidden');
          grid.innerHTML = currentSavedOrders.map(renderCard).join('');
          window.EOBookmarks?.refreshAllButtons();
        }
      } catch (e) {
        console.error('Failed to load saved orders:', e);
        loading.textContent = 'Failed to load saved orders.';
      }
    }

    // Export Handlers
    function downloadFile(content, fileName, mimeType) {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, 100);
    }

    exportJsonBtn?.addEventListener('click', () => {
      if (!currentSavedOrders.length) return;
      const dataStr = JSON.stringify(currentSavedOrders, null, 2);
      downloadFile(dataStr, 'saved-executive-orders.json', 'application/json');
    });

    exportCsvBtn?.addEventListener('click', () => {
      if (!currentSavedOrders.length) return;
      const headers = ['id', 'eo_number', 'title', 'president', 'signing_date', 'word_count', 'reading_time_minutes', 'constitutional_alignment', 'url'];
      const rows = currentSavedOrders.map(o => {
        const url = `${window.location.origin}/orders/${o.id}`;
        const fields = [
          o.id,
          o.num || '',
          `"${(o.title || '').replace(/"/g, '""')}"`,
          `"${(o.pres || '').replace(/"/g, '""')}"`,
          o.date || '',
          o.words || 0,
          o.time || 1,
          `"${(o.val || '').replace(/"/g, '""')}"`,
          url
        ];
        return fields.join(',');
      });
      const csvContent = [headers.join(','), ...rows].join('\n');
      downloadFile(csvContent, 'saved-executive-orders.csv', 'text/csv');
    });

    // Re-render live when an order is unsaved from this page (or saved elsewhere in another tab)
    document.addEventListener('eo-bookmarks-changed', (e) => {
      const card = grid.querySelector(`[data-saved-card="${e.detail.id}"]`);
      if (card && !e.detail.saved) {
        card.remove();
        currentSavedOrders = currentSavedOrders.filter(o => o.id !== e.detail.id);
        if (grid.children.length === 0) {
          empty.classList.remove('hidden');
          if (exportControls) exportControls.classList.add('hidden');
        }
      }
    });

    render();
  </script>
</Layout>
