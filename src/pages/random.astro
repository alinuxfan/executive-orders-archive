---
import Layout from '../layouts/Layout.astro';
import summaryOrders from '../../data/site_orders_summary.json';

// Select a stratified sample of 300 order IDs across the full 1789-present archive
// so /random/index.html stays lightweight (~6 KB instead of 550+ KB) while still
// providing instant zero-latency fallback if search_index.json isn't cached yet.
const SAMPLE_SIZE = 300;
const step = Math.max(1, Math.floor(summaryOrders.length / SAMPLE_SIZE));
const sampleIds: string[] = [];
for (let i = 0; i < summaryOrders.length && sampleIds.length < SAMPLE_SIZE; i += step) {
  sampleIds.push(summaryOrders[i].id);
}
const firstOrder = sampleIds[0] || 'app-executive-order-1';
---

<Layout
  title="Random Executive Order | Executive Orders Archive"
  description="Discover a random decree from United States presidential history spanning 1789 to present."
>
  <div class="min-h-[60vh] flex flex-col items-center justify-center px-4 py-16 text-center">
    <div class="max-w-md w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 shadow-xl">
      <div class="text-6xl mb-4 animate-bounce select-none">
        🎲
      </div>
      <h1 class="font-serif font-extrabold text-2xl text-slate-900 dark:text-white mb-2">
        Rolling the Presidential Archives...
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">
        Selecting a decree at random from over {summaryOrders.length.toLocaleString()} executive actions spanning 1789 to today.
      </p>
      <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden mb-6">
        <div class="bg-purple-600 h-1.5 rounded-full animate-pulse w-3/4 mx-auto"></div>
      </div>
      <a
        id="fallback-link"
        href={`/orders/${firstOrder}`}
        class="text-xs text-blue-600 dark:text-blue-400 hover:underline"
      >
        Click here if you are not redirected automatically &rarr;
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ sampleIds }}>
    (async function pickAndRedirect() {
      let pool = Array.isArray(sampleIds) ? sampleIds : [];
      if (window.EOSearch?.loadIndex) {
        try {
          const fullIndex = await Promise.race([
            window.EOSearch.loadIndex(),
            new Promise((resolve) => setTimeout(() => resolve(null), 250))
          ]);
          if (Array.isArray(fullIndex) && fullIndex.length > 0) {
            pool = fullIndex.map((o) => o.id);
          }
        } catch (e) {}
      }
      if (pool.length > 0) {
        const randomId = pool[Math.floor(Math.random() * pool.length)];
        const targetUrl = '/orders/' + encodeURIComponent(randomId);
        const fallback = document.getElementById('fallback-link');
        if (fallback) fallback.href = targetUrl;
        window.location.replace(targetUrl);
      }
    })();
  </script>
</Layout>
