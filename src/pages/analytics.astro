---
import Layout from '../layouts/Layout.astro';
import ToneChart from '../components/ToneChart.astro';
import LengthChart from '../components/LengthChart.astro';
import TimelineChart from '../components/TimelineChart.astro';
import ConstitutionalBalanceChart from '../components/ConstitutionalBalanceChart.astro';
import { getYearlyOrderCounts } from '../lib/yearly';
import { resolvePortraitSlug } from '../lib/portraits';
import { calculateYearsInOffice } from '../lib/presidentNumbers';
import { getYoungstownClassification } from '../lib/youngstown';
import orders from '../../data/site_orders_summary.json';
import presidents from '../../data/presidents.json';

const totalOrders = orders.length;
const yearlyData = getYearlyOrderCounts(orders);
const positiveOrders = orders.filter(o => (o.val || o.sentiment_valence) === "Constitutional Fidelity" || (o.val || o.sentiment_valence) === "Positive").length;
const neutralOrders = orders.filter(o => (o.val || o.sentiment_valence) === "Constitutional Neutral" || (o.val || o.sentiment_valence) === "Neutral" || !(o.val || o.sentiment_valence)).length;
const urgentOrders = orders.filter(o => (o.val || o.sentiment_valence) === "Constitutional Friction / Overreach" || (o.val || o.sentiment_valence) === "Urgent/Negative").length;

// Global Youngstown totals
let totalZone1 = 0;
let totalZone2 = 0;
let totalZone3 = 0;

for (const o of orders) {
  const z = getYoungstownClassification(o).zone;
  if (z === 1) totalZone1++;
  else if (z === 2) totalZone2++;
  else if (z === 3) totalZone3++;
}

// Map presidents. Normalize portrait slug so presidential orders aren't silently dropped.
const presStats = new Map<string, { 
  count: number; 
  totalWords: number; 
  totalSentiment: number; 
  totalGrade: number;
  zone1: number;
  zone2: number;
  zone3: number;
}>();

for (const o of orders) {
  const slug = resolvePortraitSlug(o.slug || o.president_slug);
  const cur = presStats.get(slug) || { count: 0, totalWords: 0, totalSentiment: 0, totalGrade: 0, zone1: 0, zone2: 0, zone3: 0 };
  const z = getYoungstownClassification(o).zone;
  if (z === 1) cur.zone1++;
  else if (z === 2) cur.zone2++;
  else if (z === 3) cur.zone3++;

  cur.count += 1;
  cur.totalWords += (o.words !== undefined ? o.words : (o.word_count || 0));
  cur.totalSentiment += (o.comp !== undefined ? o.comp : (o.sentiment_compound || 0));
  cur.totalGrade += (o.flesch_kincaid_grade || 12);
  presStats.set(slug, cur);
}

const enriched = presidents.map(p => {
  const s = presStats.get(p.slug);
  const count = s?.count || 0;
  return {
    name: p.name,
    party: p.party,
    orderCount: count,
    avgWordCount: count > 0 ? Math.round(s!.totalWords / count) : 0,
    avgSentiment: count > 0 ? Number((s!.totalSentiment / count).toFixed(2)) : 0,
    avgGrade: count > 0 ? Number((s!.totalGrade / count).toFixed(1)) : 0
  };
}).filter(p => p.orderCount > 0);

// Constitutional Presidents Stats for Separation of Powers & Washington Multiplier
const constitutionalPresidentsData = presidents.map(p => {
  const s = presStats.get(p.slug) || { count: 0, totalWords: 0, totalSentiment: 0, totalGrade: 0, zone1: 0, zone2: 0, zone3: 0 };
  const count = s.count;
  const years = calculateYearsInOffice(p.terms);
  const annualRate = years > 0 ? (count / years) : 0;
  const washingtonMultiplier = annualRate / 1.0;
  const avgWords = count > 0 ? Math.round(s.totalWords / count) : 0;
  const wordInflationMultiplier = avgWords > 0 ? Number((avgWords / 180).toFixed(1)) : 1.0;

  return {
    name: p.name,
    slug: p.slug,
    party: p.party,
    orderCount: count,
    yearsInOffice: years,
    annualRate,
    washingtonMultiplier,
    avgWords,
    wordInflationMultiplier,
    zone1Count: s.zone1,
    zone2Count: s.zone2,
    zone3Count: s.zone3,
    zone1Pct: count > 0 ? Number(((s.zone1 / count) * 100).toFixed(1)) : 0,
    zone2Pct: count > 0 ? Number(((s.zone2 / count) * 100).toFixed(1)) : 0,
    zone3Pct: count > 0 ? Number(((s.zone3 / count) * 100).toFixed(1)) : 0,
  };
}).filter(p => p.orderCount > 0);

// Longest order
const longestOrder = [...orders].sort((a, b) => ((b.words !== undefined ? b.words : b.word_count) || 0) - ((a.words !== undefined ? a.words : a.word_count) || 0))[0];
// Shortest order
const shortestOrder = [...orders].filter(o => ((o.words !== undefined ? o.words : o.word_count) || 0) > 30).sort((a, b) => ((a.words !== undefined ? a.words : a.word_count) || 0) - ((b.words !== undefined ? b.words : b.word_count) || 0))[0];
---

<Layout 
  title="Analytics, Trends & Graphs | Executive Orders Archive"
  description="Linguistic trends, length inflation across centuries, constitutional sentiment distribution, and legal complexity across US presidencies."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-900 dark:bg-blue-950/60 dark:text-blue-300 text-xs font-semibold uppercase tracking-wider mb-4 border border-blue-200 dark:border-blue-900">
        📊 Computational Linguistics & Constitutional Trends
      </div>
      <h1 class="font-serif font-extrabold text-3xl sm:text-5xl text-slate-900 dark:text-white leading-tight">
        Presidential Analytics & Graphs
      </h1>
      <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-3">
        Quantifying presidential power: how executive orders evolved from brief 100-word wartime decrees into massive regulatory frameworks.
      </p>
    </div>

    <!-- Comparative High-Level Insights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Longest Executive Order</div>
        <div class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 line-clamp-2">
          {longestOrder ? (
            <a href={`/orders/${longestOrder.id}`} class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">
              {longestOrder.title}
            </a>
          ) : "N/A"}
        </div>
        <div class="flex items-center justify-between text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
          <span class="font-bold text-slate-800 dark:text-slate-200">{longestOrder?.pres || longestOrder?.president_name}</span>
          <span class="font-mono bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 px-2 py-0.5 rounded font-bold">
            {((longestOrder?.words !== undefined ? longestOrder.words : longestOrder?.word_count) || 0).toLocaleString()} words (~{longestOrder?.time || longestOrder?.reading_time_minutes}m)
          </span>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Most Concise Executive Order</div>
        <div class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 line-clamp-2">
          {shortestOrder ? (
            <a href={`/orders/${shortestOrder.id}`} class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">
              {shortestOrder.title}
            </a>
          ) : "N/A"}
        </div>
        <div class="flex items-center justify-between text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
          <span class="font-bold text-slate-800 dark:text-slate-200">{shortestOrder?.pres || shortestOrder?.president_name}</span>
          <span class="font-mono bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 px-2 py-0.5 rounded font-bold">
            {(shortestOrder?.words !== undefined ? shortestOrder.words : shortestOrder?.word_count || 0).toLocaleString()} words (~1m)
          </span>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Readability & Legal Density</div>
        <div class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2">
          Post-Graduate Level (Grade 18+)
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
          Modern executive orders require an average of 18-22 years of formal education (equivalent to a Master's or J.D. degree) to parse effectively.
        </p>
      </div>

    </div>

    <!-- NEW: Constitutional Balance & Separation of Powers Framework -->
    <ConstitutionalBalanceChart 
      presidentsStats={constitutionalPresidentsData}
      totalZone1={totalZone1}
      totalZone2={totalZone2}
      totalZone3={totalZone3}
      totalOrders={totalOrders}
    />

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <ToneChart 
        positiveCount={positiveOrders}
        neutralCount={neutralOrders}
        urgentCount={urgentOrders}
        totalOrders={totalOrders}
      />
      <LengthChart
        presidents={enriched}
      />
    </div>

    <!-- Full Historical Timeline -->
    <div class="mb-12">
      <TimelineChart yearlyData={yearlyData} />
      <p class="text-xs text-slate-400 mt-3 text-center">
        Want to explore a specific year? Visit the <a href="/timeline" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold">full interactive timeline</a>.
      </p>
    </div>

  </div>
</Layout>
