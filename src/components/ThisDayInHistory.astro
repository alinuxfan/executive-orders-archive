---
import rawOrders from '../../data/site_orders_summary.json';
import { resolvePortraitSlug } from '../lib/portraits';

// Default to US Eastern Time (Washington, D.C. where presidential orders originate) at build time.
// In the client browser, dynamic hydration aligns this with the user's local timezone.
const now = new Date();
const easternParts = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).formatToParts(now);
const partMap = Object.fromEntries(easternParts.map(p => [p.type, p.value]));
const currentYear = parseInt(partMap.year, 10);
const currentMonth = partMap.month;
const currentDay = partMap.day;
const currentMonthDay = `${currentMonth}-${currentDay}`;

const monthNames = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December"
];
const currentMonthIndex = parseInt(currentMonth, 10) - 1;
const currentMonthName = monthNames[currentMonthIndex];
const dayNumber = parseInt(currentDay, 10);

// Filter orders matching today's month and day across all years
const todayOrders = rawOrders
  .filter(o => o.signing_date && o.signing_date.slice(5, 10) === currentMonthDay)
  .sort((a, b) => {
    // Sort descending by year
    const yearA = parseInt(a.signing_date.slice(0, 4), 10);
    const yearB = parseInt(b.signing_date.slice(0, 4), 10);
    return yearB - yearA;
  });
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" id="this-day-section">
  <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 border-2 border-blue-900/60 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
    
    <!-- Background Watermark -->
    <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none select-none text-9xl font-serif">
      🏛️
    </div>

    <!-- Header & Interactive Date Controls -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-blue-800/40 relative z-10">
      <div>
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-400 font-sans mb-1">
          <span>📅 This Day in Presidential History</span>
          <span>•</span>
          <span id="active-date-label">{currentMonthName} {dayNumber}</span>
          <span id="history-tz-badge" class="text-[10px] text-blue-300 font-mono font-normal"></span>
        </div>
        <h2 class="font-serif font-extrabold text-2xl sm:text-3xl text-white">
          Orders Signed on <span id="heading-date" class="text-amber-300">{currentMonthName} {dayNumber}</span> Through the Ages
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl font-light">
          Discover which landmark decrees, wartime mobilizations, and executive orders were signed on this calendar date across presidential administrations.
        </p>
      </div>

      <!-- Quick Date Selector -->
      <div class="flex items-center gap-2 bg-slate-850/80 p-1.5 rounded-2xl border border-blue-700/50 backdrop-blur-sm self-stretch md:self-auto">
        <label for="history-date-picker" class="text-xs text-slate-300 font-medium pl-2 hidden sm:inline">Pick Date:</label>
        <input 
          type="date" 
          id="history-date-picker" 
          value={`${currentYear}-${currentMonth}-${currentDay}`}
          class="bg-slate-900 text-xs sm:text-sm text-white px-3 py-1.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400"
        />
        <button 
          id="reset-today-btn"
          class="px-2.5 py-1.5 rounded-xl bg-blue-700 hover:bg-blue-600 text-[11px] font-semibold text-white transition-colors"
        >
          Today
        </button>
      </div>
    </div>

    <!-- Orders Feed for This Day -->
    <div class="mt-6 relative z-10">
      <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
        <span id="history-count-badge">Found {todayOrders.length} historic order{todayOrders.length === 1 ? '' : 's'}</span>
        <span id="history-span-badge" class="text-[11px] opacity-75">Spanning {todayOrders.length > 0 ? `${todayOrders[todayOrders.length - 1].signing_date.slice(0, 4)} – ${todayOrders[0].signing_date.slice(0, 4)}` : 'Various Eras'}</span>
      </div>

      <div id="history-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {todayOrders.map(order => {
          const year = order.signing_date ? order.signing_date.slice(0, 4) : 'Undated';
          const portraitSlug = resolvePortraitSlug(order.president_slug);
          let sentimentColor = "bg-slate-800 text-slate-300 border-slate-700";
          if (order.sentiment_valence === "Constitutional Fidelity" || order.sentiment_valence === "Positive") {
            sentimentColor = "bg-emerald-950/60 text-emerald-300 border-emerald-800";
          } else if (order.sentiment_valence === "Constitutional Friction / Overreach" || order.sentiment_valence === "Urgent/Negative") {
            sentimentColor = "bg-rose-950/60 text-rose-300 border-rose-800";
          }

          return (
            <div class="history-item bg-slate-900/90 hover:bg-slate-850 border border-slate-800 hover:border-blue-700/60 rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between group shadow-md">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <div class="flex items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded font-mono text-xs font-bold bg-amber-400/10 text-amber-300 border border-amber-400/20">
                      {year}
                    </span>
                    {order.eo_number ? (
                      <span class="px-1.5 py-0.5 rounded font-mono text-[11px] bg-blue-900/40 text-blue-200 border border-blue-800/40">
                        EO {order.eo_number}
                      </span>
                    ) : null}
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class={`text-[10px] font-medium px-2 py-0.5 rounded-full border ${sentimentColor}`}>
                      {order.sentiment_valence || 'Order'}
                    </span>
                    <button
                      type="button"
                      data-bookmark-btn={order.id}
                      aria-label="Save this order"
                      aria-pressed="false"
                      class="p-1 rounded-md text-slate-500 hover:text-amber-400 hover:bg-slate-800 transition-colors"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                    </button>
                  </div>
                </div>

                <h3 class="font-serif font-bold text-sm sm:text-base text-slate-100 group-hover:text-amber-300 line-clamp-2 transition-colors mb-2">
                  <a href={`/orders/${order.id}`}>
                    {order.title}
                  </a>
                </h3>

                {order.snippet ? (
                  <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">
                    {order.snippet}
                  </p>
                ) : null}
              </div>

              <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
                <div class="flex items-center gap-2">
                  <img
                    src={`/portraits/${portraitSlug}.jpg`}
                    alt=""
                    class="w-5 h-5 rounded-full object-cover border border-slate-700"
                    onerror="this.style.display='none'"
                  />
                  <span class="truncate max-w-[130px] font-medium text-slate-300">{order.president_name}</span>
                </div>
                <a href={`/orders/${order.id}`} class="text-amber-400 hover:text-amber-300 font-semibold text-[11px]">
                  Read &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <div id="history-empty" class="hidden text-center py-12 bg-slate-900/60 rounded-2xl border border-slate-800">
        <p class="text-slate-300 text-sm font-serif">No executive orders found for this calendar date.</p>
        <p class="text-slate-500 text-xs mt-1">Try another month or day using the date picker above.</p>
      </div>
    </div>

  </div>
</section>

<script is:inline define:vars={{ currentYear, currentMonth, currentDay, currentMonthName, dayNumber }}>
  const picker = document.getElementById('history-date-picker');
  const resetBtn = document.getElementById('reset-today-btn');
  const headingDate = document.getElementById('heading-date');
  const activeDateLabel = document.getElementById('active-date-label');
  const countBadge = document.getElementById('history-count-badge');
  const spanBadge = document.getElementById('history-span-badge');
  const container = document.getElementById('history-cards-grid');
  const emptyView = document.getElementById('history-empty');
  const tzBadge = document.getElementById('history-tz-badge');

  const monthNames = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
  ];

  function getUserLocalDate() {
    const d = new Date();
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    const monthIndex = d.getMonth();
    const dayInt = d.getDate();
    return {
      year,
      month,
      day,
      monthDay: `${month}-${day}`,
      monthName: monthNames[monthIndex],
      dayInt,
      dateStr: `${year}-${month}-${day}`
    };
  }

  let dataset = null;

  async function loadData() {
    if (dataset) return dataset;
    try {
      const res = await fetch('/search_index.json');
      dataset = await res.json();
    } catch (e) {
      console.error('Failed to load search index:', e);
      dataset = [];
    }
    return dataset;
  }

  function renderHistoryCard(order) {
    const rawDate = order.date || order.signing_date || '';
    const year = rawDate.slice(0, 4) || 'Undated';
    const val = order.val || order.sentiment_valence;
    let sentimentColor = "bg-slate-800 text-slate-300 border-slate-700";
    if (val === "Constitutional Fidelity" || val === "Positive") {
      sentimentColor = "bg-emerald-950/60 text-emerald-300 border-emerald-800";
    } else if (val === "Constitutional Friction / Overreach" || val === "Urgent/Negative") {
      sentimentColor = "bg-rose-950/60 text-rose-300 border-rose-800";
    }

    const num = order.num !== undefined ? order.num : order.eo_number;
    const eoBadge = num ? 
      `<span class="px-1.5 py-0.5 rounded font-mono text-[11px] bg-blue-900/40 text-blue-200 border border-blue-800/40">EO ${num}</span>` : '';

    const slug = window.resolvePortraitSlug ? window.resolvePortraitSlug(order.slug || order.president_slug) : (order.slug || order.president_slug || 'default');
    const presName = order.pres || order.president_name;
    const snippet = order.snip || order.snippet || '';

    return `
      <div class="history-item bg-slate-900/90 hover:bg-slate-850 border border-slate-800 hover:border-blue-700/60 rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between group shadow-md">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-1.5">
              <span class="px-2 py-0.5 rounded font-mono text-xs font-bold bg-amber-400/10 text-amber-300 border border-amber-400/20">${year}</span>
              ${eoBadge}
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] font-medium px-2 py-0.5 rounded-full border ${sentimentColor}">
                ${val || 'Order'}
              </span>
              <button type="button" data-bookmark-btn="${order.id}" aria-label="Save this order" aria-pressed="false" class="p-1 rounded-md text-slate-500 hover:text-amber-400 hover:bg-slate-800 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
              </button>
            </div>
          </div>

          <h3 class="font-serif font-bold text-sm sm:text-base text-slate-100 group-hover:text-amber-300 line-clamp-2 transition-colors mb-2">
            <a href="/orders/${order.id}">${order.title}</a>
          </h3>

          ${snippet ? `<p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">${snippet}</p>` : ''}
        </div>

        <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <img src="/portraits/${slug}.jpg" alt="" class="w-5 h-5 rounded-full object-cover border border-slate-700" onerror="this.style.display='none'" />
            <span class="truncate max-w-[130px] font-medium text-slate-300">${presName}</span>
          </div>
          <a href="/orders/${order.id}" class="text-amber-400 hover:text-amber-300 font-semibold text-[11px]">Read &rarr;</a>
        </div>
      </div>
    `;
  }

  async function updateForDate(dateStr) {
    if (!dateStr) return;
    const parts = dateStr.split('-');
    if (parts.length < 3) return;
    const mm = parts[1];
    const dd = parts[2];
    const targetMonthDay = `${mm}-${dd}`;
    const monthName = monthNames[parseInt(mm, 10) - 1];
    const dayInt = parseInt(dd, 10);

    if (headingDate) headingDate.textContent = `${monthName} ${dayInt}`;
    if (activeDateLabel) activeDateLabel.textContent = `${monthName} ${dayInt}`;

    const data = await loadData();
    const matches = data
      .filter(o => {
        const d = o.date || o.signing_date;
        return d && d.slice(5, 10) === targetMonthDay;
      })
      .sort((a, b) => {
        const yA = parseInt((a.date || a.signing_date || '0').slice(0, 4), 10);
        const yB = parseInt((b.date || b.signing_date || '0').slice(0, 4), 10);
        return yB - yA;
      });

    if (countBadge) {
      countBadge.textContent = `Found ${matches.length} historic order${matches.length === 1 ? '' : 's'}`;
    }

    if (spanBadge) {
      if (matches.length > 0) {
        const oldest = (matches[matches.length - 1].date || matches[matches.length - 1].signing_date || '').slice(0, 4);
        const newest = (matches[0].date || matches[0].signing_date || '').slice(0, 4);
        spanBadge.textContent = oldest && newest ? `Spanning ${oldest} – ${newest}` : 'Various Eras';
      } else {
        spanBadge.textContent = 'Various Eras';
      }
    }

    if (matches.length > 0) {
      container.innerHTML = matches.map(renderHistoryCard).join('');
      emptyView.classList.add('hidden');
      window.EOBookmarks?.refreshAllButtons();
    } else {
      container.innerHTML = '';
      emptyView.classList.remove('hidden');
    }
  }

  // Determine user's local date in their browser timezone
  const userToday = getUserLocalDate();
  const serverMonthDay = `${currentMonth}-${currentDay}`;

  // Populate user's detected local timezone abbreviation
  try {
    const tzName = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const tzAbbr = new Intl.DateTimeFormat('en-US', { timeZoneName: 'short' })
      .formatToParts(new Date())
      .find(p => p.type === 'timeZoneName')?.value || '';
    if (tzBadge) {
      tzBadge.textContent = tzAbbr ? `(${tzAbbr})` : `(${tzName})`;
      tzBadge.title = `Using your local timezone: ${tzName}`;
    }
  } catch (e) {}

  // Sync date picker with user's local date
  if (picker) {
    picker.value = userToday.dateStr;
  }

  // If user's local month/day differs from server build date (e.g. UTC rollover or timezone difference),
  // immediately update the view for the user's timezone date
  if (userToday.monthDay !== serverMonthDay) {
    updateForDate(userToday.dateStr);
  }

  picker?.addEventListener('change', (e) => {
    updateForDate(e.target.value);
  });

  resetBtn?.addEventListener('click', () => {
    const todayUser = getUserLocalDate();
    if (picker) picker.value = todayUser.dateStr;
    updateForDate(todayUser.dateStr);
  });
</script>
