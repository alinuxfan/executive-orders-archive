---
import Layout from '../layouts/Layout.astro';
import PresidentCard from '../components/PresidentCard.astro';
import OrderCard from '../components/OrderCard.astro';
import ToneChart from '../components/ToneChart.astro';
import LengthChart from '../components/LengthChart.astro';
import ThisDayInHistory from '../components/ThisDayInHistory.astro';
import { resolvePortraitSlug } from '../lib/portraits';
import { primaryNumber } from '../lib/presidentNumbers';

import rawOrders from '../../data/site_orders_summary.json';
import presidentsData from '../../data/presidents.json';
import statsData from '../../data/stats.json';

// Calculate live aggregate stats
const totalOrders = rawOrders.length;
const totalWords = rawOrders.reduce((sum, o) => sum + (o.word_count || 0), 0);
const avgReadingTime = totalOrders > 0 ? Math.round(rawOrders.reduce((sum, o) => sum + (o.reading_time_minutes || 0), 0) / totalOrders) : 0;
const avgGrade = totalOrders > 0 ? (rawOrders.reduce((sum, o) => sum + (o.flesch_kincaid_grade || 0), 0) / totalOrders).toFixed(1) : "18.0";

const positiveCount = rawOrders.filter(o => o.sentiment_valence === "Constitutional Fidelity" || o.sentiment_valence === "Positive").length;
const neutralCount = rawOrders.filter(o => o.sentiment_valence === "Constitutional Neutral" || o.sentiment_valence === "Neutral").length;
const urgentCount = rawOrders.filter(o => o.sentiment_valence === "Constitutional Friction / Overreach" || o.sentiment_valence === "Urgent/Negative").length;

// Map presidents with counts. Some harvest sources report a president identifier
// that doesn't match the canonical presidents.json slug (e.g. Clinton, Ford, Biden,
// G.H.W. Bush, and both Trump terms) — normalize through resolvePortraitSlug so
// those orders aren't silently dropped from their president's stats.
const presidentMap = new Map<string, { count: number; totalWords: number; totalSentiment: number }>();
for (const o of rawOrders) {
  const slug = resolvePortraitSlug(o.president_slug);
  const existing = presidentMap.get(slug) || { count: 0, totalWords: 0, totalSentiment: 0 };
  existing.count += 1;
  existing.totalWords += o.word_count || 0;
  existing.totalSentiment += o.sentiment_compound || 0;
  presidentMap.set(slug, existing);
}

// Enhance presidents list with order statistics
const enrichedPresidents = presidentsData.map(p => {
  const stats = presidentMap.get(p.slug);
  const count = stats?.count || 0;
  const avgWordCount = count > 0 ? Math.round(stats!.totalWords / count) : 0;
  const avgSentiment = count > 0 ? stats!.totalSentiment / count : undefined;

  return {
    ...p,
    orderCount: count,
    avgWordCount,
    avgSentiment
  };
});

// Sort presidents by number ascending (George Washington #1 to Donald Trump #47)
const sortedPresidents = [...enrichedPresidents].sort((a, b) => primaryNumber(a.numbers) - primaryNumber(b.numbers));

// Filter out presidents with zero orders for the length chart
const lengthChartPresidents = sortedPresidents
  .filter(p => p.orderCount > 0)
  .map(p => ({
    name: p.name,
    party: p.party,
    orderCount: p.orderCount,
    avgWordCount: p.avgWordCount,
    avgSentiment: p.avgSentiment !== undefined ? Number(p.avgSentiment.toFixed(2)) : 0,
    avgGrade: Number(avgGrade)
  }));

// Most recent orders for the homepage feed
const recentOrders = rawOrders.slice(0, 6);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Executive Orders Archive",
  "url": new URL("/", Astro.site).toString(),
  "description": "A comprehensive historical archive of United States Presidential Executive Orders from 1789 to present.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": new URL("/search?q={search_term_string}", Astro.site).toString()
    },
    "query-input": "required name=search_term_string"
  }
};

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Executive Orders Archive",
  "url": new URL("/", Astro.site).toString(),
  "logo": new URL("/favicon.svg", Astro.site).toString()
};
---

<Layout
  title="Executive Orders Archive | Every President Analyzed"
  description="Explore all US Presidential Executive Orders with sentiment analysis, reading time, length, and plain-English summaries."
  structuredData={[websiteJsonLd, organizationJsonLd]}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-flag-blue via-slate-900 to-slate-950 text-white py-16 sm:py-24 overflow-hidden border-b border-blue-900/50">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <!-- Decorative Watermark Seal -->
    <div class="absolute inset-0 opacity-5 pointer-events-none flex items-center justify-center">
      <span class="text-[360px] font-serif font-black select-none">★</span>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-950/80 border border-blue-800/60 text-blue-300 text-xs font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Every US President • 1789 to Today • Scored Through the Constitution</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold font-serif tracking-tight text-white mb-6 max-w-4xl mx-auto leading-tight">
        Every Executive Order. <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-200 to-yellow-400">
          Scored, Analyzed & Decoded.
        </span>
      </h1>

      <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-light">
        Constitutional sentiment scoring from the prism of an early American statesman, operative directive extraction, reading times, and plain-English distillations.
      </p>

      <!-- Instant Search Jump Bar -->
      <div class="max-w-2xl mx-auto">
        <form action="/search" method="GET" class="relative flex items-center">
          <input 
            type="text" 
            name="q"
            placeholder="Search by topic, president, or keyword (e.g. defense, tariff, lincoln, vaccines)..."
            class="w-full pl-12 pr-28 py-4 rounded-xl bg-slate-800/90 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent text-sm shadow-xl"
          />
          <div class="absolute left-4 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <button 
            type="submit" 
            class="absolute right-2 px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-semibold text-xs transition-colors shadow"
          >
            Explore
          </button>
        </form>
      </div>

    </div>
  </section>

  <!-- Key Metric KPI Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      
      <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Orders Analyzed</div>
        <div class="text-2xl sm:text-3xl font-extrabold font-serif text-slate-900 dark:text-white">
          {totalOrders.toLocaleString()}
        </div>
        <div class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-1 flex items-center gap-1 font-medium">
          <span>✓ 100% full text indexed</span>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Average Reading Time</div>
        <div class="text-2xl sm:text-3xl font-extrabold font-serif text-slate-900 dark:text-white">
          {avgReadingTime} <span class="text-base font-sans font-normal text-slate-500">min</span>
        </div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
          ~{(totalWords / totalOrders).toFixed(0)} avg words per order
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Constitutional Alignment</div>
        <div class="text-2xl sm:text-3xl font-extrabold font-serif text-emerald-600 dark:text-emerald-400">
          {Math.round((positiveCount / totalOrders) * 100)}% <span class="text-xs font-sans font-normal text-slate-500">Fidelity</span>
        </div>
        <div class="text-[11px] text-rose-600 dark:text-rose-400 mt-1">
          {Math.round((urgentCount / totalOrders) * 100)}% overreach / friction
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Legal Readability</div>
        <div class="text-2xl sm:text-3xl font-extrabold font-serif text-slate-900 dark:text-white">
          Grade {avgGrade}
        </div>
        <div class="text-[11px] text-amber-600 dark:text-amber-400 mt-1 font-medium">
          Flesch-Kincaid (Graduate Level)
        </div>
      </div>

    </div>
  </section>

  <!-- This Day in History Dynamic Feature -->
  <ThisDayInHistory />

  <!-- Founding Charters Teaser Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 dark:from-slate-900 dark:via-slate-850 dark:to-slate-900 border-2 border-amber-300/80 dark:border-amber-700/60 rounded-3xl p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400 font-sans">
            <span>📜 Constitutional Library</span>
            <span>•</span>
            <span>The Organic Law</span>
          </div>
          <h2 class="font-serif font-extrabold text-2xl sm:text-3xl text-slate-900 dark:text-white">
            The Founding Charters of the Republic
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Read the authentic, unabridged texts: the <strong>Declaration of Independence (1776)</strong>, <strong>Articles of Confederation (1777)</strong>, the <strong>United States Constitution (1787)</strong>, all <strong>27 Amendments</strong>, and the <strong>State Ratifying Convention Debates</strong>.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <a 
            href="/founding/constitution" 
            class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow transition-all font-sans"
          >
            Constitution (Art. II)
          </a>
          <a 
            href="/founding/amendments" 
            class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs shadow transition-all font-sans"
          >
            All 27 Amendments
          </a>
          <a 
            href="/founding" 
            class="px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-medium text-xs shadow transition-all font-sans"
          >
            Explore Library &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Charts & Trends Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <ToneChart 
        positiveCount={positiveCount}
        neutralCount={neutralCount}
        urgentCount={urgentCount}
        totalOrders={totalOrders}
      />
      <LengthChart 
        presidents={lengthChartPresidents}
      />
    </div>
  </section>

  <!-- Presidential Portrait Gallery -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-8 gap-4">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 font-sans">
          The Presidencies
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-serif text-slate-900 dark:text-white">
          Presidents & Administrations
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          Click any president to inspect their full executive decree history and constitutional posture.
        </p>
      </div>

      <a href="/presidents" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
        <span>View all 45 presidents</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sortedPresidents.slice(0, 9).map(p => (
        <PresidentCard president={p} />
      ))}
    </div>
  </section>

  <!-- Recent Executive Orders Feed -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 font-sans">
          Latest Ingestion
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-serif text-slate-900 dark:text-white">
          Recent Executive Orders
        </h2>
      </div>

      <a href="/orders" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
        <span>Browse full archive</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentOrders.map(order => (
        <OrderCard order={order} />
      ))}
    </div>
  </section>
</Layout>
